-- Hackage dependency pins for reproducible builds (cabal freeze, with the
-- GHC boot libraries removed so any GHC 9.8.x works). Refresh after a
-- deliberate upgrade: `cabal freeze`, then drop the boot packages again.
active-repositories: hackage.haskell.org:merge
index-state: hackage.haskell.org 2026-10-13T00:04:23Z
constraints: any.case-insensitive ==1.2.1.0,
             any.hashable ==1.5.1.0,
             any.integer-logarithms ==1.0.5,
             any.megaparsec ==9.8.3,
             any.os-string ==2.0.11,
             any.parser-combinators ==1.3.1,
             any.primitive ==0.9.1.0,
             any.scientific ==0.3.9.0
