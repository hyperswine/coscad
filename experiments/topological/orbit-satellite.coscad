disc_height = 4
neck_height = 3
peg_height = 3.6
peg_overlap = 0.2
tip_overlap = 0.1
disc = ◎ 6.5 disc_height
neck = (▻ 6.5 7.8) ∩ (◎ 6.5 neck_height)
peg = ◎ 2.4 peg_height
tip = (▻ 2.4 2.4) ∩ (◎ 2.4 0.5)
main = disc |> at top neck
  |> at top 0 0 -peg_overlap peg
  |> at top 0 0 -tip_overlap tip
// Oriented joint interfaces; construction metadata does not add material.
  |> frame peg_seat_rotor1 ctr top bak 0 0 1.6
