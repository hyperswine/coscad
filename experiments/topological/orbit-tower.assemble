// Pilot: anchor-based part internals; existing assembly poses are retained.
// 20 physical pieces. All parts have their intended print face declared.
plate 256 256 7
base ← orbit-base.coscad ×1 ▽bot material=pla
axle1 ← orbit-axle.coscad ×1 ▽bot material=pla after=base
axle2 ← orbit-axle.coscad ×1 ▽bot material=pla after=rotor#1
axle3 ← orbit-axle.coscad ×1 ▽bot material=pla after=rotor#2
axle4 ← orbit-axle.coscad ×1 ▽bot material=pla after=rotor#3
axle5 ← orbit-axle.coscad ×1 ▽bot material=pla after=rotor#4
axle6 ← orbit-axle.coscad ×1 ▽bot material=pla after=rotor#5
rotor ← orbit-rotor.coscad ×6 ▽bot material=pla
satellite ← orbit-satellite.coscad ×6 ▽bot material=pla
cap ← orbit-cap.coscad ×1 ▽bot material=pla after=rotor#6
asm = base
  ⊕ (axle1 |> move 0 0 6)
  ⊕ (rotor |> move 0 0 13)
  ⊕ (satellite |> rotx 180 |> move 24 0 24.5)
  ⊕ (axle2 |> move 0 0 21)
  ⊕ (rotor |> rotz 60 |> move 0 0 28)
  ⊕ (satellite |> rotx 180 |> move 24 0 0 |> rotz 60 |> move 0 0 39.5)
  ⊕ (axle3 |> move 0 0 36)
  ⊕ (rotor |> rotz 120 |> move 0 0 43)
  ⊕ (satellite |> rotx 180 |> move 24 0 0 |> rotz 120 |> move 0 0 54.5)
  ⊕ (axle4 |> move 0 0 51)
  ⊕ (rotor |> rotz 180 |> move 0 0 58)
  ⊕ (satellite |> rotx 180 |> move 24 0 0 |> rotz 180 |> move 0 0 69.5)
  ⊕ (axle5 |> move 0 0 66)
  ⊕ (rotor |> rotz 240 |> move 0 0 73)
  ⊕ (satellite |> rotx 180 |> move 24 0 0 |> rotz 240 |> move 0 0 84.5)
  ⊕ (axle6 |> move 0 0 81)
  ⊕ (rotor |> rotz 300 |> move 0 0 88)
  ⊕ (satellite |> rotx 180 |> move 24 0 0 |> rotz 300 |> move 0 0 99.5)
  ⊕ (cap |> move 0 0 96)

// The rotor seats on an internal shoulder, 13 mm below the axle's top.
// The next axle captures it; after= above keeps that entry open.
fastener peg axle1 base top
fastener peg rotor#1 axle1 top inset=13
fastener peg satellite#1 rotor#1 top
fastener peg axle2 axle1 top
fastener peg rotor#2 axle2 top inset=13
fastener peg satellite#2 rotor#2 top
fastener peg axle3 axle2 top
fastener peg rotor#3 axle3 top inset=13
fastener peg satellite#3 rotor#3 top
fastener peg axle4 axle3 top
fastener peg rotor#4 axle4 top inset=13
fastener peg satellite#4 rotor#4 top
fastener peg axle5 axle4 top
fastener peg rotor#5 axle5 top inset=13
fastener peg satellite#5 rotor#5 top
fastener peg axle6 axle5 top
fastener peg rotor#6 axle6 top inset=13
fastener peg satellite#6 rotor#6 top
fastener peg cap axle6 top

plan rest=bot
