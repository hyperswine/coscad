cabal-version: 2.4
-- 2.4 or newer: the vendored kernel trees are described with file globs, and
-- older spec versions silently skip dotted names such as clipper.core.h.

name:           coscad
version:        1.6.0.0
description:    Please see the README on GitHub at <https://github.com/hyperswine/coscad#readme>
homepage:       https://github.com/hyperswine/coscad#readme
bug-reports:    https://github.com/hyperswine/coscad/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md
    stdlib/README.md
    stdlib/examples/*.coscad
    experiments/bonded/*.json
    experiments/assembly-fea/*.json
    experiments/assembly-fea/*.coscad
    experiments/assembly-fea/*.assemble
    experiments/bonded/README.md
    experiments/beam.coscad
    experiments/cad/*.coscad
    experiments/cad/*.json
    native-kernel.lock.json
    third-party/manifold/LICENSE
    third-party/manifold/README.md
    third-party/manifold/include/manifold/*.h
    third-party/manifold/src/*.h
    third-party/clipper2/LICENSE
    third-party/clipper2/README.md
    third-party/clipper2/CPP/Clipper2Lib/include/clipper2/*.h
    third-party/bosl2/LICENSE
    third-party/bosl2/README.md
    scripts/assembly-region-preview.sol
    scripts/bonded-shelf.sol
    scripts/check-docs.sol
    scripts/package-release.sol
    scripts/render-boats.sol
    scripts/slice-prepared.sol
    scripts/update-formula.sol
    scripts/sol-only-check.sol
    models/tesseract-v3-threaded/*.sol
    test/native/bridge_smoke.cpp

source-repository head
  type: git
  location: https://github.com/hyperswine/coscad

library
  exposed-modules:
      Coscad.Assemble
      Coscad.Instance
      Coscad.Assembly.Instances
      Coscad.Backend
      Coscad.Check
      Coscad.Codegen
      Coscad.Constraint
      Coscad.Diagnose
      Coscad.Directive
      Coscad.Dim
      Coscad.Doctor
      Coscad.Dsl
      Coscad.Format
      Coscad.Geometry
      Coscad.IO
      Coscad.Image
      Coscad.Json
      Coscad.Linalg
      Coscad.Loft
      Coscad.Manifold
      Coscad.Mass
      Coscad.Mass.Command
      Coscad.Mesh
      Coscad.Mesh.Distance
      Coscad.Mesh.Indexed
      Coscad.Next
      Coscad.Parser
      Coscad.Parser.Core
      Coscad.Parser.Grammar
      Coscad.Parser.Program
      Coscad.Part
      Coscad.Plan
      Coscad.Plan.Model
      Coscad.Plan.Options
      Coscad.Plan.Geometry
      Coscad.Plan.Calibrate
      Coscad.Plan.Render
      Coscad.Plan.Search
      Coscad.Printability
      Coscad.Report
      Coscad.Shape
      Coscad.Stdlib
      Coscad.Solid
      Coscad.Site
      Coscad.Stress.Bonded
      Coscad.Stress.Assembly
      Coscad.Stress.Cad
      Coscad.Stress.Experiment
      Coscad.Stress.Tetra
      Coscad.Stress.Sparse
      Coscad.Stress.Voxel
      Coscad.Stress.Hex20
      Coscad.Stress.Material
      Coscad.Stress.Part
      Coscad.Stress.Command
      Coscad.Validate
      Coscad.Variants
      Coscad.Words
      Lib
  other-modules:
      Coscad.Stress.Linear
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , array >=0.5 && <0.6
    , bytestring
    , text
    , cryptohash-sha256 >=0.11 && <0.12
    , containers
    , directory
    , filepath
    , JuicyPixels >=3.3 && <3.4
    , megaparsec
    , process
  default-language: Haskell2010
  -- The pinned geometry kernel (native-kernel.lock.json: Manifold 3.5.2 with
  -- Clipper2 2.0.1) is vendored under third-party/ and compiled into this
  -- library, so `cabal build` needs no CMake, pkg-config or download. These
  -- defines mirror the lock's CMake configuration; -O3 is listed last so it
  -- wins over the optimization flag cabal passes for its own profile,
  -- because the kernel is compute bound.
  include-dirs:
      third-party/manifold/include
      third-party/clipper2/CPP/Clipper2Lib/include
  cxx-options:
      -std=c++17 -O3
      -DMANIFOLD_CROSS_SECTION -DMANIFOLD_PAR=-1
      -DCLIPPER2_MAX_DECIMAL_PRECISION=8
  cxx-sources:
      cbits/coscad_manifold.cpp
      third-party/manifold/src/boolean3.cpp
      third-party/manifold/src/boolean_result.cpp
      third-party/manifold/src/constructors.cpp
      third-party/manifold/src/csg_tree.cpp
      third-party/manifold/src/edge_op.cpp
      third-party/manifold/src/execution_impl.cpp
      third-party/manifold/src/face_op.cpp
      third-party/manifold/src/impl.cpp
      third-party/manifold/src/manifold.cpp
      third-party/manifold/src/minkowski.cpp
      third-party/manifold/src/polygon.cpp
      third-party/manifold/src/properties.cpp
      third-party/manifold/src/quickhull.cpp
      third-party/manifold/src/sdf.cpp
      third-party/manifold/src/smoothing.cpp
      third-party/manifold/src/sort.cpp
      third-party/manifold/src/subdivision.cpp
      third-party/manifold/src/tree2d.cpp
      third-party/manifold/src/cross_section/cross_section.cpp
      third-party/clipper2/CPP/Clipper2Lib/src/clipper.engine.cpp
      third-party/clipper2/CPP/Clipper2Lib/src/clipper.offset.cpp
      third-party/clipper2/CPP/Clipper2Lib/src/clipper.rectclip.cpp
      third-party/clipper2/CPP/Clipper2Lib/src/clipper.triangulation.cpp
  if os(darwin)
    extra-libraries: c++
  else
    extra-libraries: stdc++

executable coscad
  main-is: Main.hs
  other-modules:
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N -qn4"
  build-depends:
      base >=4.7 && <5
    , containers
    , coscad
    , directory
    , filepath
    , megaparsec
    , process
  default-language: Haskell2010
  if os(darwin)
    ghc-options: -optP-Wno-nonportable-include-path

test-suite coscad-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Harness
      MigrationCases
      Oracle.OpenScad
      Tier.Assembly
      Tier.Words
      Tier.Cli
      Tier.Diagnostics
      Tier.Examples
      Tier.Experiments
      Tier.Geometry
      Tier.Linalg
      Tier.Manufacturing
      Tier.Plan
      Tier.Image
      Tier.Resolution
      Tier.Silence
      Tier.Bonded
      Tier.Mass
      Tier.Instances
      Tier.Stress
      Tier.Stdlib
      Tier.Validate
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      test
  build-tool-depends:
      coscad:coscad
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N -qn4"
  build-depends:
      base >=4.7 && <5
    , array >=0.5 && <0.6
    , containers
    , coscad
    , directory
    , filepath
    , JuicyPixels >=3.3 && <3.4
    , megaparsec
    , process
    , time
  default-language: Haskell2010

executable coscad-experiments
  main-is: Main.hs
  hs-source-dirs: experiments
  ghc-options: -Wall -Wcompat -threaded -rtsopts
  build-depends:
      base >=4.7 && <5
    , containers
    , coscad
    , time
  default-language: Haskell2010

-- examples/haskell/ are ghci samples, not library code; this suite only
-- keeps them compiling. Warnings are off because the samples are written
-- for reading (unsigned top-level bindings, shadowing), not for -Wall.
test-suite haskell-examples
  type: exitcode-stdio-1.0
  main-is: HaskellExamples.hs
  other-modules:
      ExampleBookend
      ExampleBookend2
      ExampleGear
      ExampleZigZag
  hs-source-dirs:
      test
      examples/haskell
  ghc-options: -w
  build-depends:
      base >=4.7 && <5
    , coscad
  default-language: Haskell2010
