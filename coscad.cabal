cabal-version: 2.2

name:           coscad
version:        1.3.0.0
description:    Please see the README on GitHub at <https://github.com/hyperswine/coscad#readme>
homepage:       https://github.com/hyperswine/coscad#readme
bug-reports:    https://github.com/hyperswine/coscad/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md
    experiments/beam.coscad
    experiments/cad/*.coscad
    experiments/cad/*.json
    native-kernel.lock.json
    third-party/manifold/LICENSE
    third-party/manifold/README.md
    third-party/bosl2/LICENSE
    third-party/bosl2/README.md
    scripts/build-manifold.py
    scripts/compare-fea-reference.py
    scripts/compare-cad-fea-reference.py
    scripts/compare-native-pipeline.py
    scripts/compare-tetra-fea-reference.py
    scripts/mesh-fea-tetra.py
    experiments/requirements-fea.txt
    test/native/bridge_smoke.cpp
    test/golden/native-supported.txt

flag manifold
  description: Link the pinned native Manifold geometry kernel
  default: False
  manual: True

source-repository head
  type: git
  location: https://github.com/hyperswine/coscad

library
  exposed-modules:
      Coscad.Assemble
      Coscad.Backend
      Coscad.Check
      Coscad.Codegen
      Coscad.Constraint
      Coscad.Diagnose
      Coscad.Dim
      Coscad.Doctor
      Coscad.Dsl
      Coscad.Format
      Coscad.Geometry
      Coscad.IO
      Coscad.Json
      Coscad.Linalg
      Coscad.Manifold
      Coscad.Mesh
      Coscad.Mesh.Distance
      Coscad.Mesh.Indexed
      Coscad.Next
      Coscad.OpenScad
      Coscad.Parser
      Coscad.Part
      Coscad.Plan
      Coscad.Plan.Model
      Coscad.Plan.Render
      Coscad.Plan.Search
      Coscad.Printability
      Coscad.Report
      Coscad.Shape
      Coscad.Site
      Coscad.Stress.Cad
      Coscad.Stress.Experiment
      Coscad.Stress.Tetra
      Coscad.Stress.Sparse
      Coscad.Stress.Voxel
      Coscad.Stress.Hex20
      Coscad.Stress.Spec
      Coscad.Stress.Material
      Coscad.Stress.Part
      Coscad.Stress.Command
      Coscad.Validate
      Coscad.Variants
      Lib
  other-modules:
      Coscad.Stress.Linear
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , array >=0.5 && <0.6
    , containers
    , directory
    , filepath
    , megaparsec
    , process
  default-language: Haskell2010
  if flag(manifold)
    cpp-options: -DCOSCAD_MANIFOLD
    cxx-sources: cbits/coscad_manifold.cpp
    cxx-options: -std=c++17
    pkgconfig-depends: manifold ==3.5.2
    if os(darwin)
      extra-libraries: c++
    else
      extra-libraries: stdc++

executable coscad
  main-is: Main.hs
  other-modules:
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , containers
    , coscad
    , directory
    , filepath
    , megaparsec
    , process
  default-language: Haskell2010
  if os(darwin)
    ghc-options: -optP-Wno-nonportable-include-path

test-suite coscad-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Harness
      MigrationCases
      Tier.Assembly
      Tier.Cli
      Tier.Diagnostics
      Tier.Examples
      Tier.Experiments
      Tier.Geometry
      Tier.Linalg
      Tier.Manufacturing
      Tier.Plan
      Tier.Resolution
      Tier.Silence
      Tier.Stress
      Tier.Validate
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      test
  build-tool-depends:
      coscad:coscad
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , array >=0.5 && <0.6
    , containers
    , coscad
    , directory
    , filepath
    , megaparsec
    , process
    , time
  default-language: Haskell2010

executable coscad-experiments
  main-is: Main.hs
  hs-source-dirs: experiments
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.7 && <5
    , containers
    , coscad
    , time
  default-language: Haskell2010

-- examples/haskell/ are ghci samples, not library code; this suite only
-- keeps them compiling. Warnings are off because the samples are written
-- for reading (unsigned top-level bindings, shadowing), not for -Wall.
test-suite haskell-examples
  type: exitcode-stdio-1.0
  main-is: HaskellExamples.hs
  other-modules:
      ExampleBookend
      ExampleBookend2
      ExampleGear
      ExampleZigZag
  hs-source-dirs:
      test
      examples/haskell
  ghc-options: -w
  build-depends:
      base >=4.7 && <5
    , coscad
  default-language: Haskell2010
