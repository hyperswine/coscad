cabal-version: 2.2

name:           coscad
version:        1.2.0.0
description:    Please see the README on GitHub at <https://github.com/hyperswine/coscad#readme>
homepage:       https://github.com/hyperswine/coscad#readme
bug-reports:    https://github.com/hyperswine/coscad/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/hyperswine/coscad

library
  exposed-modules:
      Coscad.Assemble
      Coscad.Check
      Coscad.Codegen
      Coscad.Constraint
      Coscad.Dim
      Coscad.Doctor
      Coscad.Dsl
      Coscad.Format
      Coscad.Geometry
      Coscad.IO
      Coscad.Json
      Coscad.Linalg
      Coscad.Mesh
      Coscad.Next
      Coscad.OpenScad
      Coscad.Parser
      Coscad.Part
      Coscad.Plan
      Coscad.Plan.Model
      Coscad.Plan.Render
      Coscad.Plan.Search
      Coscad.Printability
      Coscad.Shape
      Coscad.Site
      Coscad.Validate
      Coscad.Variants
      Lib
  other-modules:
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , containers
    , directory
    , filepath
    , megaparsec
    , process
  default-language: Haskell2010

executable coscad
  main-is: Main.hs
  other-modules:
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , containers
    , coscad
    , directory
    , filepath
    , megaparsec
    , process
  default-language: Haskell2010
  if os(darwin)
    ghc-options: -optP-Wno-nonportable-include-path

test-suite coscad-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Harness
      MigrationCases
      Tier.Assembly
      Tier.Cli
      Tier.Diagnostics
      Tier.Examples
      Tier.Geometry
      Tier.Linalg
      Tier.Manufacturing
      Tier.Plan
      Paths_coscad
  autogen-modules:
      Paths_coscad
  hs-source-dirs:
      test
  build-tool-depends:
      coscad:coscad
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , containers
    , coscad
    , directory
    , filepath
    , megaparsec
    , process
    , time
  default-language: Haskell2010
