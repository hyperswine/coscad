// AeroFold phone stand — Coscad remake
// Units: millimetres. Main coordinates: X width, Y front(-)/rear(+), Z up.
// Functional envelope: 88 x 98 x 98.482 mm; 20 degree rearward phone lean.
// The original selective 3D edge chamfers are represented by chamfered 2D profiles.

// Rounded forked base and front charging/cable opening
base_outline = ✎ -44 -48 -43.967371 -48.206011 -43.934742 -48.412023 -43.902113 -48.618034 -43.80742 -48.803879 -43.712727 -48.989725 -43.618034 -49.175571 -43.470546 -49.323058 -43.323058 -49.470546 -43.175571 -49.618034 -42.989725 -49.712727 -42.803879 -49.80742 -42.618034 -49.902113 -42.412023 -49.934742 -42.206011 -49.967371 -42 -50 -14 -50 14 -50 42 -50 42.206011 -49.967371 42.412023 -49.934742 42.618034 -49.902113 42.803879 -49.80742 42.989725 -49.712727 43.175571 -49.618034 43.323058 -49.470546 43.470546 -49.323058 43.618034 -49.175571 43.712727 -48.989725 43.80742 -48.803879 43.902113 -48.618034 43.934742 -48.412023 43.967371 -48.206011 44 -48 44 -20.241367 44 7.517267 44 35.2759 43.993575 35.368234 43.98715 35.460568 43.980725 35.552902 43.961573 35.643456 43.942421 35.734011 43.92327 35.824565 43.891761 35.911594 43.860252 35.998623 43.828743 36.085652 43.785485 36.167478 43.742226 36.249304 43.698967 36.33113 43.644792 36.406177 43.590617 36.481223 43.536443 36.556269 40.557526 40.130969 37.578609 43.705669 34.599693 47.280369 34.517455 47.36311 34.435217 47.445852 34.35298 47.528593 34.257578 47.595733 34.162176 47.662872 34.066775 47.730011 33.96113 47.779492 33.855485 47.828974 33.749841 47.878455 33.637188 47.908763 33.524536 47.939071 33.411883 47.969379 33.295672 47.979586 33.179461 47.989793 33.06325 48 11.021083 48 -11.021083 48 -33.06325 48 -33.179461 47.989793 -33.295672 47.979586 -33.411883 47.969379 -33.524536 47.939071 -33.637188 47.908763 -33.749841 47.878455 -33.855485 47.828974 -33.96113 47.779492 -34.066775 47.730011 -34.162176 47.662872 -34.257578 47.595733 -34.35298 47.528593 -34.435217 47.445852 -34.517455 47.36311 -34.599693 47.280369 -37.578609 43.705669 -40.557526 40.130969 -43.536443 36.556269 -43.590617 36.481223 -43.644792 36.406177 -43.698967 36.33113 -43.742226 36.249304 -43.785485 36.167478 -43.828743 36.085652 -43.860252 35.998623 -43.891761 35.911594 -43.92327 35.824565 -43.942421 35.734011 -43.961573 35.643456 -43.980725 35.552902 -43.98715 35.460568 -43.993575 35.368234 -44 35.2759 -44 7.517267 -44 -20.241367 -44 -48
notch_outline = ✎ -16 -52 -5.333333 -52 5.333333 -52 16 -52 16 -33.333333 16 -14.666667 16 4 14 7.333333 12 10.666667 10 14 3.333333 14 -3.333333 14 -10 14 -12 10.666667 -14 7.333333 -16 4 -16 -14.666667 -16 -33.333333 -16 -52
base_outer = ⮕ 4 base_outline
base_notch = ζ -1 (⮕ 6 notch_outline)
base_rib = χ -16.2 (ψ -24 (▬ 32.4 10 4))
base = (base_outer ⊖ base_notch) ⊕ base_rib

// Back panel, extended 3 mm into the base for a supported junction
back_outline = ✎ -41 -3 -13.666667 -3 13.666667 -3 41 -3 41 30.88 41 64.76 41 98.64 40.666667 98.973333 40.333333 99.306667 40 99.64 13.333333 99.64 -13.333333 99.64 -40 99.64 -40.333333 99.306667 -40.666667 98.973333 -41 98.64 -41 64.76 -41 30.88 -41 -3
back = ψ -18 (ζ 4 (θ -20 (ψ 2.5 (θ 90 (⮕ 5 back_outline)))))

// Pointed hexagonal openings; their roofs avoid flat overhangs
hex_left_outline = ✎ -24 82 -21.333333 77.833333 -18.666667 73.666667 -16 69.5 -16 61.166667 -16 52.833333 -16 44.5 -18.666667 40.333333 -21.333333 36.166667 -24 32 -26.666667 36.166667 -29.333333 40.333333 -32 44.5 -32 52.833333 -32 61.166667 -32 69.5 -29.333333 73.666667 -26.666667 77.833333 -24 82
hex_mid_outline = ✎ 0 82 2.666667 77.833333 5.333333 73.666667 8 69.5 8 61.166667 8 52.833333 8 44.5 5.333333 40.333333 2.666667 36.166667 0 32 -2.666667 36.166667 -5.333333 40.333333 -8 44.5 -8 52.833333 -8 61.166667 -8 69.5 -5.333333 73.666667 -2.666667 77.833333 0 82
hex_right_outline = ✎ 24 82 26.666667 77.833333 29.333333 73.666667 32 69.5 32 61.166667 32 52.833333 32 44.5 29.333333 40.333333 26.666667 36.166667 24 32 21.333333 36.166667 18.666667 40.333333 16 44.5 16 52.833333 16 61.166667 16 69.5 18.666667 73.666667 21.333333 77.833333 24 82
hex_left = ψ -18 (ζ 4 (θ -20 (ψ 5 (θ 90 (⮕ 10 hex_left_outline)))))
hex_mid = ψ -18 (ζ 4 (θ -20 (ψ 5 (θ 90 (⮕ 10 hex_mid_outline)))))
hex_right = ψ -18 (ζ 4 (θ -20 (ψ 5 (θ 90 (⮕ 10 hex_right_outline)))))

// Continuous 45-degree seat/retaining-arm profiles, 27 mm wide each
arm_outline = ✎ -15 1 -21.333333 7.333333 -27.666667 13.666667 -34 20 -34 23.666667 -34 27.333333 -34 31 -33 31 -32 31 -31 31 -31 27.333333 -31 23.666667 -31 20 -25.666667 20 -20.333333 20 -15 20 -15 13.666667 -15 7.333333 -15 1
arm_left = χ -41 (ω 90 (θ 90 (⮕ 27 arm_outline)))
arm_right = χ 14 (ω 90 (θ 90 (⮕ 27 arm_outline)))

// Rear A-frame legs, 8 mm wide and 6 mm profile thickness
leg_outline = ✎ 36.082875 0.299725 28.483547 31.956146 20.884218 63.612567 13.28489 95.268987 15.229639 95.735837 17.174389 96.202687 19.119139 96.669537 26.718467 65.013116 34.317796 33.356695 41.917125 1.700275 39.972375 1.233425 38.027625 0.766575 36.082875 0.299725
leg_left = χ -38 (ω 90 (θ 90 (⮕ 8 leg_outline)))
leg_right = χ 30 (ω 90 (θ 90 (⮕ 8 leg_outline)))

solid = base ⊕ back ⊕ arm_left ⊕ arm_right ⊕ leg_left ⊕ leg_right
main = solid ⊖ hex_left ⊖ hex_mid ⊖ hex_right
