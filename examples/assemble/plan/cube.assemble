// 200 mm outside cube: twelve 2020 rails, sixteen flat L brackets, one panel.
// One grounded rail; every other pose follows interfaces. Both holes of each
// bracket are constrained, closing loops across its two supporting rails.
!glyph
plate 250 250 6
bottom_front ← rail200.coscad ×0 profile=2020 material=aluminium
bottom_back ← rail200.coscad ×0 profile=2020 material=aluminium
bottom_left ← rail160.coscad ×0 profile=2020 material=aluminium
bottom_right ← rail160.coscad ×0 profile=2020 material=aluminium
top_front ← rail200.coscad ×0 profile=2020 material=aluminium
top_back ← rail200.coscad ×0 profile=2020 material=aluminium
top_left ← rail160.coscad ×0 profile=2020 material=aluminium
top_right ← rail160.coscad ×0 profile=2020 material=aluminium
upright_fl ← rail160.coscad ×0 profile=2020 material=printed
upright_fr ← rail160.coscad ×0 profile=2020 material=printed
upright_bl ← rail160.coscad ×0 profile=2020 material=printed
upright_br ← rail160.coscad ×0 profile=2020 material=printed
br_bottom_fl ← flat90.coscad ×1
br_bottom_fr ← flat90.coscad ×1
br_bottom_bl ← flat90.coscad ×1
br_bottom_br ← flat90.coscad ×1
br_top_fl ← flat90.coscad ×1
br_top_fr ← flat90.coscad ×1
br_top_bl ← flat90.coscad ×1
br_top_br ← flat90.coscad ×1
br_front_low_left ← flat90.coscad ×1
br_front_low_right ← flat90.coscad ×1
br_back_low_left ← flat90.coscad ×1
br_back_low_right ← flat90.coscad ×1
br_front_high_left ← flat90.coscad ×1
br_front_high_right ← flat90.coscad ×1
br_back_high_left ← flat90.coscad ×1
br_back_high_right ← flat90.coscad ×1
panel ← panel190.coscad ×1

fixed bottom_front 100 10 10 0 0 0

// Bottom ring: both Y rails close the front/back loop.
mate bottom_left @end_low bottom_front @join_back_left
mate bottom_right @end_low bottom_front @join_back_right
mate bottom_back @join_front_left bottom_left @end_high
mate bottom_back @join_front_right bottom_right @end_high

// Uprights and top ring; redundant interfaces check height and squareness.
mate upright_fl @end_low bottom_front @upright_up_left
mate top_front @upright_down_left upright_fl @end_high
mate upright_fr @end_low bottom_front @upright_up_right
mate top_front @upright_down_right upright_fr @end_high
mate upright_bl @end_low bottom_back @upright_up_left
mate top_back @upright_down_left upright_bl @end_high
mate upright_br @end_low bottom_back @upright_up_right
mate top_back @upright_down_right upright_br @end_high
mate top_left @end_low top_front @join_back_left
mate top_right @end_low top_front @join_back_right
mate top_back @join_front_left top_left @end_high
mate top_back @join_front_right top_right @end_high

// Ring brackets: leg directions point into the ring from each corner.
mate br_bottom_fl @a_top bottom_front @bolt_bot_low
mate br_bottom_fl @b_top bottom_left @bolt_bot_low
mate br_bottom_fr @b_top bottom_front @bolt_bot_high
mate br_bottom_fr @a_top bottom_right @bolt_bot_low
mate br_bottom_bl @b_top bottom_back @bolt_bot_low
mate br_bottom_bl @a_top bottom_left @bolt_bot_high
mate br_bottom_br @a_top bottom_back @bolt_bot_high
mate br_bottom_br @b_top bottom_right @bolt_bot_high
mate br_top_fl @a_bot top_front @bolt_top_low
mate br_top_fl @b_bot top_left @bolt_top_low
mate br_top_fr @b_bot top_front @bolt_top_high
mate br_top_fr @a_bot top_right @bolt_top_low
mate br_top_bl @b_bot top_back @bolt_top_low
mate br_top_bl @a_bot top_left @bolt_top_high
mate br_top_br @a_bot top_back @bolt_top_high
mate br_top_br @b_bot top_right @bolt_top_high

// Side brackets: local contact face differs on the front and back.
mate br_front_low_left @a_bot bottom_front @bolt_fwd_low
mate br_front_low_left @b_bot upright_fl @bolt_fwd_low
mate br_front_low_right @b_bot bottom_front @bolt_fwd_high
mate br_front_low_right @a_bot upright_fr @bolt_fwd_low
mate br_back_low_left @a_top bottom_back @bolt_bak_low
mate br_back_low_left @b_top upright_bl @bolt_bak_low
mate br_back_low_right @b_top bottom_back @bolt_bak_high
mate br_back_low_right @a_top upright_br @bolt_bak_low
mate br_front_high_left @b_bot top_front @bolt_fwd_low
mate br_front_high_left @a_bot upright_fl @bolt_fwd_high
mate br_front_high_right @a_bot top_front @bolt_fwd_high
mate br_front_high_right @b_bot upright_fr @bolt_fwd_high
mate br_back_high_left @b_top top_back @bolt_bak_low
mate br_back_high_left @a_top upright_bl @bolt_bak_high
mate br_back_high_right @a_top top_back @bolt_bak_high
mate br_back_high_right @b_top upright_br @bolt_bak_high

// All six panel bores close onto the intended rail slot centres.
mate panel @lower_front bottom_right @panel_low
mate panel @lower_back bottom_right @panel_high
mate panel @upper_front top_right @panel_low
mate panel @upper_back top_right @panel_high
mate panel @side_front upright_fr @panel_middle
mate panel @side_back upright_br @panel_middle

// Hardware declarations remain separate from rigid geometric mates.
fastener M5x10 br_bottom_fl bottom_front bot at=30
fastener M5x10 br_bottom_fl bottom_left bot at=10
fastener M5x10 br_bottom_fr bottom_front bot at=170
fastener M5x10 br_bottom_fr bottom_right bot at=10
fastener M5x10 br_bottom_bl bottom_back bot at=30
fastener M5x10 br_bottom_bl bottom_left bot at=150
fastener M5x10 br_bottom_br bottom_back bot at=170
fastener M5x10 br_bottom_br bottom_right bot at=150
fastener M5x10 br_top_fl top_front top at=30
fastener M5x10 br_top_fl top_left top at=10
fastener M5x10 br_top_fr top_front top at=170
fastener M5x10 br_top_fr top_right top at=10
fastener M5x10 br_top_bl top_back top at=30
fastener M5x10 br_top_bl top_left top at=150
fastener M5x10 br_top_br top_back top at=170
fastener M5x10 br_top_br top_right top at=150
fastener M5x10 br_front_low_left bottom_front fwd at=30
fastener M5x10 br_front_low_left upright_fl fwd at=10
fastener M5x10 br_front_low_right bottom_front fwd at=170
fastener M5x10 br_front_low_right upright_fr fwd at=10
fastener M5x10 br_back_low_left bottom_back bak at=30
fastener M5x10 br_back_low_left upright_bl bak at=10
fastener M5x10 br_back_low_right bottom_back bak at=170
fastener M5x10 br_back_low_right upright_br bak at=10
fastener M5x10 br_front_high_left top_front fwd at=30
fastener M5x10 br_front_high_left upright_fl fwd at=150
fastener M5x10 br_front_high_right top_front fwd at=170
fastener M5x10 br_front_high_right upright_fr fwd at=150
fastener M5x10 br_back_high_left top_back bak at=30
fastener M5x10 br_back_high_left upright_bl bak at=150
fastener M5x10 br_back_high_right top_back bak at=170
fastener M5x10 br_back_high_right upright_br bak at=150
// Panel screw distances are measured from each host rail minimum end.
fastener M5x10 panel bottom_right rt ×2 at=40,120
fastener M5x10 panel top_right rt ×2 at=40,120
fastener M5x10 panel upright_fr rt at=80
fastener M5x10 panel upright_br rt at=80
