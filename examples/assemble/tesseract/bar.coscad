// 76 mm shoulder-to-shoulder, 7 mm square edge, integral 3 mm end keys.
body = ▣ 76 7 7 0.4
neck = xcyl 2.1 1.95 |> move 38.85 0 0
collar = xcyl 2.7 1 |> move 40.3 0 0
end = neck ⊕ collar
main = body ⊕ end ⊕ (end |> rotz 180)
  |> frame bar_socket_corner1 ctr lft top -40.8 0 0
  |> frame bar_socket_corner3 ctr rt top 40.8 0 0
