// Repeat the failed joint coupon with a broader cap foot and explicit brim.
// Each part reserves its 8 mm brim on the plate (brim=8); bambu-slice.py
// prints that brim. The extra full-length bar checks its collars with
// slicer supports enabled.
plate 256 256 6
corner ← ../corner.coscad ×1 ▽lft+fwd+bot brim=8
cap ← ../cap.coscad ×1 ▽lft+fwd+bot brim=8
bar ← ../test-bar.coscad ×1 ▽rt brim=8
fullbar ← ../bar.coscad ×1 ▽fwd brim=8
fixed corner 0 0 0 0 0 0
mate cap @lock corner @lock
mate bar @end corner @bar_socket_bar1
fixed fullbar 100 0 0 0 0 0
