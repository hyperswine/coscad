// Shared dimensions are duplicated deliberately in the two printable halves.
// 12 mm hubs versus 19 mm on the bolted version; bars are 7 mm wide.
C = 12
half = C / 2
d = 54.735610317245346
collar_r = 2.8
neck_r = 2.2
blank = ▣ C C C 0.4 |> move half half half
// Shouldered end: 5.4 mm collar at x=9.2..10.2, 4.2 mm neck to x=12.
x_socket = (xcyl collar_r 1.2 |> move 9.7 half half) ⊕ (xcyl neck_r 2.3 |> move 11.25 half half)
// Swept open channels admit each half along its diagonal closing direction.
y_socket = x_socket |> rotz 90 |> move C 0 0
z_socket = x_socket |> roty -90 |> move C 0 0
x_open = x_socket ⇓ (x_socket |> move 12 12 12)
y_open = y_socket ⇓ (y_socket |> move 12 12 12)
z_open = z_socket ⇓ (z_socket |> move 12 12 12)
sockets = x_open ⊕ y_open ⊕ z_open
// Half-space z>=0, oriented along the body diagonal. Split at x+y+z=21.
positive = box 100 100 100 |> move 0 0 50 |> roty d |> rotz 45 |> move 7 7 7
// A 0.03 mm radial interference on a split 3.36 mm pin is a starting fit.
// Print the coupon first: printer/material variation can exceed this amount.
fit = 0.03
pin_r = 1.65 + fit
pin = (zcyl pin_r 2.9 |> move 0 0 1.25) ⊖ (box 0.7 4 3 |> move 0 0 2)
locking_pin = pin |> roty d |> rotz 45 |> move 7 7 7
// Flat outer diagonal print foot; orient its outward -111 face down.
outer_trim = positive |> move -6 -6 -6
main = (((blank ⊖ positive) ∩ outer_trim) ⊕ locking_pin) ⊖ sockets
  |> frame lock ctr rt+bak+top top 1 1 1
