// Tesseract: a 100 mm wire-frame cube (8 corner blocks, 12 bars, M3
// screws threading into the bar ends) with a 30 mm cube suspended at its
// centre by 8 diagonal friction pegs, one to each corner block.
// Corner blocks are one part rotated into each corner; the bars and struts
// are one part each. Screws: 24 x M3x10 socket head, no nuts.
plate 256 256 6
corner ← corner.coscad ×8 ▽bot
bar    ← bar.coscad ×12
strut  ← strut.coscad ×8
inner  ← inner.coscad ×1 ▽bot

asm = (corner |> move 0 0 0)
  ⊕ (corner |> rotz 90 |> move 100 0 0)
  ⊕ (corner |> rotz 180 |> move 100 100 0)
  ⊕ (corner |> rotz 270 |> move 0 100 0)
  ⊕ (corner |> rotx 180 |> rotz 90 |> move 0 0 100)
  ⊕ (corner |> rotx 180 |> rotz 180 |> move 100 0 100)
  ⊕ (corner |> rotx 180 |> rotz 270 |> move 100 100 100)
  ⊕ (corner |> rotx 180 |> move 0 100 100)
  ⊕ (bar |> move 50 11 11)
  ⊕ (bar |> move 50 89 11)
  ⊕ (bar |> move 50 11 89)
  ⊕ (bar |> move 50 89 89)
  ⊕ (bar |> rotz 90 |> move 11 50 11)
  ⊕ (bar |> rotz 90 |> move 89 50 11)
  ⊕ (bar |> rotz 90 |> move 11 50 89)
  ⊕ (bar |> rotz 90 |> move 89 50 89)
  ⊕ (bar |> roty 90 |> move 11 11 50)
  ⊕ (bar |> roty 90 |> move 89 11 50)
  ⊕ (bar |> roty 90 |> move 89 89 50)
  ⊕ (bar |> roty 90 |> move 11 89 50)
  ⊕ (strut |> roty 54.7356 |> rotz 45 |> move 29.36 29.36 29.36)
  ⊕ (strut |> roty 54.7356 |> rotz 135 |> move 70.64 29.36 29.36)
  ⊕ (strut |> roty 54.7356 |> rotz 225 |> move 70.64 70.64 29.36)
  ⊕ (strut |> roty 54.7356 |> rotz 315 |> move 29.36 70.64 29.36)
  ⊕ (strut |> roty 54.7356 |> rotz 225 |> move 29.36 29.36 70.64)
  ⊕ (strut |> roty 54.7356 |> rotz 315 |> move 70.64 29.36 70.64)
  ⊕ (strut |> roty 54.7356 |> rotz 45 |> move 70.64 70.64 70.64)
  ⊕ (strut |> roty 54.7356 |> rotz 135 |> move 29.36 70.64 70.64)
  ⊕ (inner |> move 50 50 50)

// bars into corner sockets: M3 through the corner wall into the bar end
fastener M3x10 corner#1 bar#1 top head=socket nut=none through=5
fastener M3x10 corner#2 bar#1 top head=socket nut=none through=5
fastener M3x10 corner#4 bar#2 top head=socket nut=none through=5
fastener M3x10 corner#3 bar#2 top head=socket nut=none through=5
fastener M3x10 corner#5 bar#3 top head=socket nut=none through=5
fastener M3x10 corner#6 bar#3 top head=socket nut=none through=5
fastener M3x10 corner#8 bar#4 top head=socket nut=none through=5
fastener M3x10 corner#7 bar#4 top head=socket nut=none through=5
fastener M3x10 corner#1 bar#5 top head=socket nut=none through=5
fastener M3x10 corner#4 bar#5 top head=socket nut=none through=5
fastener M3x10 corner#2 bar#6 top head=socket nut=none through=5
fastener M3x10 corner#3 bar#6 top head=socket nut=none through=5
fastener M3x10 corner#5 bar#7 top head=socket nut=none through=5
fastener M3x10 corner#8 bar#7 top head=socket nut=none through=5
fastener M3x10 corner#6 bar#8 top head=socket nut=none through=5
fastener M3x10 corner#7 bar#8 top head=socket nut=none through=5
fastener M3x10 corner#1 bar#9 rt head=socket nut=none through=5
fastener M3x10 corner#5 bar#9 bak head=socket nut=none through=5
fastener M3x10 corner#2 bar#10 bak head=socket nut=none through=5
fastener M3x10 corner#6 bar#10 lft head=socket nut=none through=5
fastener M3x10 corner#3 bar#11 lft head=socket nut=none through=5
fastener M3x10 corner#7 bar#11 fwd head=socket nut=none through=5
fastener M3x10 corner#4 bar#12 fwd head=socket nut=none through=5
fastener M3x10 corner#8 bar#12 rt head=socket nut=none through=5

// diagonal struts: pegs into the corner blocks and into the inner cube
fastener peg strut#1 corner#1 rt
fastener peg strut#1 inner lft
fastener peg strut#2 corner#2 lft
fastener peg strut#2 inner rt
fastener peg strut#3 corner#3 lft
fastener peg strut#3 inner rt
fastener peg strut#4 corner#4 rt
fastener peg strut#4 inner lft
fastener peg strut#5 corner#5 rt
fastener peg strut#5 inner lft
fastener peg strut#6 corner#6 lft
fastener peg strut#6 inner rt
fastener peg strut#7 corner#7 lft
fastener peg strut#7 inner rt
fastener peg strut#8 corner#8 rt
fastener peg strut#8 inner lft

plan beam=20
