// Temporary support included for build instructions; remove it last.
// 100 mm tesseract, 12 mm split corner hubs, integral friction caps.
// Joint metadata describes final poses, not an insertion-path proof.
plate 256 256 6
corner1 ← corner.coscad ×1 ▽lft+fwd+bot after=strut1
cap1 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner2 ← corner.coscad ×1 ▽lft+fwd+bot after=strut2
cap2 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner3 ← corner.coscad ×1 ▽lft+fwd+bot after=strut3
cap3 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner4 ← corner.coscad ×1 ▽lft+fwd+bot after=strut4
cap4 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner5 ← corner.coscad ×1 ▽lft+fwd+bot after=strut5
cap5 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner6 ← corner.coscad ×1 ▽lft+fwd+bot after=strut6
cap6 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner7 ← corner.coscad ×1 ▽lft+fwd+bot after=strut7
cap7 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
corner8 ← corner.coscad ×1 ▽lft+fwd+bot after=strut8
cap8 ← cap.coscad ×1 ▽lft+fwd+bot after=bar1,bar2,bar3,bar4,bar5,bar6,bar7,bar8,bar9,bar10,bar11,bar12
bar1 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar2 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar3 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar4 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar5 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar6 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar7 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar8 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar9 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar10 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar11 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
bar12 ← bar.coscad ×1 after=corner1,corner2,corner3,corner4,corner5,corner6,corner7,corner8
strut1 ← strut.coscad ×1 ▽bot after=inner
strut2 ← strut.coscad ×1 ▽bot after=inner
strut3 ← strut.coscad ×1 ▽bot after=inner
strut4 ← strut.coscad ×1 ▽bot after=inner
strut5 ← strut.coscad ×1 ▽bot after=inner
strut6 ← strut.coscad ×1 ▽bot after=inner
strut7 ← strut.coscad ×1 ▽bot after=inner
strut8 ← strut.coscad ×1 ▽bot after=inner
inner ← inner.coscad ×1 ▽bot after=jig
jig ← jig.coscad ×1 ▽bot

fixed corner1 0 0 0 0 0 0
fixed jig 50 50 0 0 0 0
mate bar1 @bar_socket_corner1 corner1 @bar_socket_bar1
mate bar6 @bar_socket_corner1 corner2 @bar_socket_bar1
mate bar2 @bar_socket_corner3 corner3 @bar_socket_bar1
mate bar5 @bar_socket_corner3 corner4 @bar_socket_bar1
mate bar7 @bar_socket_corner1 corner5 @bar_socket_bar1 roll=-180
mate bar3 @bar_socket_corner3 corner6 @bar_socket_bar1 roll=-180
mate bar8 @bar_socket_corner3 corner7 @bar_socket_bar1 roll=-180
mate bar4 @bar_socket_corner1 corner8 @bar_socket_bar1 roll=-180
mate bar5 @bar_socket_corner1 corner1 @bar_socket_bar5
mate bar1 @bar_socket_corner3 corner2 @bar_socket_bar5
mate bar6 @bar_socket_corner3 corner3 @bar_socket_bar5
mate bar2 @bar_socket_corner1 corner4 @bar_socket_bar5
mate bar3 @bar_socket_corner1 corner5 @bar_socket_bar5 roll=180
mate bar8 @bar_socket_corner1 corner6 @bar_socket_bar5 roll=180
mate bar4 @bar_socket_corner3 corner7 @bar_socket_bar5 roll=180
mate bar7 @bar_socket_corner3 corner8 @bar_socket_bar5 roll=180
mate bar9 @bar_socket_corner3 corner1 @bar_socket_bar9 roll=-90
mate bar10 @bar_socket_corner3 corner2 @bar_socket_bar9 roll=-180
mate bar11 @bar_socket_corner3 corner3 @bar_socket_bar9 roll=90
mate bar12 @bar_socket_corner3 corner4 @bar_socket_bar9
mate bar9 @bar_socket_corner1 corner5 @bar_socket_bar9
mate bar10 @bar_socket_corner1 corner6 @bar_socket_bar9 roll=90
mate bar11 @bar_socket_corner1 corner7 @bar_socket_bar9 roll=180
mate bar12 @bar_socket_corner1 corner8 @bar_socket_bar9 roll=-90
mate strut1 @diagonal_socket_corner1 corner1 @diagonal_socket_strut1
mate inner @inner_socket_strut1 strut1 @inner_socket_inner
mate strut2 @diagonal_socket_corner1 corner2 @diagonal_socket_strut1
mate inner @inner_socket_strut2 strut2 @inner_socket_inner
mate strut3 @diagonal_socket_corner1 corner3 @diagonal_socket_strut1
mate inner @inner_socket_strut3 strut3 @inner_socket_inner
mate strut4 @diagonal_socket_corner1 corner4 @diagonal_socket_strut1
mate inner @inner_socket_strut4 strut4 @inner_socket_inner
mate strut5 @diagonal_socket_corner5 corner5 @diagonal_socket_strut1 roll=-180
mate inner @inner_socket_strut5 strut5 @inner_socket_inner_2
mate strut6 @diagonal_socket_corner5 corner6 @diagonal_socket_strut1 roll=-180
mate inner @inner_socket_strut6 strut6 @inner_socket_inner_2
mate strut7 @diagonal_socket_corner5 corner7 @diagonal_socket_strut1 roll=-180
mate inner @inner_socket_strut7 strut7 @inner_socket_inner_2
mate strut8 @diagonal_socket_corner5 corner8 @diagonal_socket_strut1 roll=-180
mate inner @inner_socket_strut8 strut8 @inner_socket_inner_2


// Integral printed joints: peg records a connection, not a separate fastener.
mate cap1 @lock corner1 @lock
fastener peg strut1 inner lft
fastener peg corner1 strut1 lft
fastener peg cap1 corner1 bot
mate cap2 @lock corner2 @lock
fastener peg strut2 inner rt
fastener peg corner2 strut2 rt
fastener peg cap2 corner2 bot
mate cap3 @lock corner3 @lock
fastener peg strut3 inner rt
fastener peg corner3 strut3 rt
fastener peg cap3 corner3 bot
mate cap4 @lock corner4 @lock
fastener peg strut4 inner lft
fastener peg corner4 strut4 lft
fastener peg cap4 corner4 bot
mate cap5 @lock corner5 @lock
fastener peg strut5 inner lft
fastener peg corner5 strut5 lft
fastener peg cap5 corner5 top
mate cap6 @lock corner6 @lock
fastener peg strut6 inner rt
fastener peg corner6 strut6 rt
fastener peg cap6 corner6 top
mate cap7 @lock corner7 @lock
fastener peg strut7 inner rt
fastener peg corner7 strut7 rt
fastener peg cap7 corner7 top
mate cap8 @lock corner8 @lock
fastener peg strut8 inner lft
fastener peg corner8 strut8 lft
fastener peg cap8 corner8 top
fastener peg bar1 corner1 rt inset=2.8
fastener peg bar1 corner2 lft inset=2.8
fastener peg bar2 corner4 rt inset=2.8
fastener peg bar2 corner3 lft inset=2.8
fastener peg bar3 corner5 rt inset=2.8
fastener peg bar3 corner6 lft inset=2.8
fastener peg bar4 corner8 rt inset=2.8
fastener peg bar4 corner7 lft inset=2.8
fastener peg bar5 corner1 bak inset=2.8
fastener peg bar5 corner4 fwd inset=2.8
fastener peg bar6 corner2 bak inset=2.8
fastener peg bar6 corner3 fwd inset=2.8
fastener peg bar7 corner5 bak inset=2.8
fastener peg bar7 corner8 fwd inset=2.8
fastener peg bar8 corner6 bak inset=2.8
fastener peg bar8 corner7 fwd inset=2.8
fastener peg bar9 corner1 top inset=2.8
fastener peg bar9 corner5 bot inset=2.8
fastener peg bar10 corner2 top inset=2.8
fastener peg bar10 corner6 bot inset=2.8
fastener peg bar11 corner3 top inset=2.8
fastener peg bar11 corner7 bot inset=2.8
fastener peg bar12 corner4 top inset=2.8
fastener peg bar12 corner8 bot inset=2.8
plan beam=30
