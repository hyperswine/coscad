// Corner block, 19 mm: three square sockets (6.4 wide, 5.8 deep) for the
// 6 mm bars. Each bar is held by one M3x16 that crosses the block through
// the bar end's hole: head recessed in an outer face, hex nut in a pocket
// on the opposite (inner) face, flats toward the block's faces. The three screws run along Z, X and Y
// for the X, Y and Z sockets, so they never cross and the block keeps its
// three-fold symmetry about the diagonal; the strut peg socket runs down
// that diagonal from the inner corner. Local frame: outer corner at the
// origin, bars leave along +X, +Y, +Z.
C    = 19
bar  = 6.4
deep = 6
hexr = 3.3
main = box C C C |> move (C / 2) (C / 2) (C / 2)
  |> cutat lft+fwd+bot 16.1 9.5 9.5 (box deep bar bar)     // +X socket
  |> cutat lft+fwd+bot 9.5 16.1 9.5 (box bar deep bar)     // +Y socket
  |> cutat lft+fwd+bot 9.5 9.5 16.1 (box bar bar deep)     // +Z socket
  // +X socket: screw along Z, head on the bottom face, nut pocket on top
  |> cutat lft+fwd+bot 16.1 9.5 9.5 (zcyl 1.7 40)
  |> cutat lft+fwd+bot 16.1 9.5 0 (zcyl 3 6)
  |> cutat lft+fwd+bot 16.1 9.5 19 (⎏ 6 hexr 8 |> rotz 30)
  // +Y socket: screw along X, head on the -X face, nut pocket on +X
  |> cutat lft+fwd+bot 9.5 16.1 9.5 (xcyl 1.7 40)
  |> cutat lft+fwd+bot 0 16.1 9.5 (xcyl 3 6)
  |> cutat lft+fwd+bot 19 16.1 9.5 (⎏ 6 hexr 8 |> roty 90)
  // +Z socket: screw along Y, head on the -Y face, nut pocket on +Y
  |> cutat lft+fwd+bot 9.5 9.5 16.1 (ycyl 1.7 40)
  |> cutat lft+fwd+bot 9.5 0 16.1 (ycyl 3 6)
  |> cutat lft+fwd+bot 9.5 19 16.1 (⎏ 6 hexr 8 |> rotx 90)
  // strut peg socket down the body diagonal from the inner corner
  |> cutat lft+fwd+bot 18 18 18 (zcyl 2.65 10 |> roty 54.7356 |> rotz 45)
