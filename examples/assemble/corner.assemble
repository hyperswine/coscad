// Named rigid interfaces; coordinate reference retained under test/fixtures/assemblies.
!glyph
plate 220 220 6
railH ← rail200.coscad ×0
railV ← rail120.coscad ×0
inner ← inner90.coscad ×1 ▽bak
bracket1 ← bracket90.coscad ×1 ▽top seam=rear material=petg
bracket2 ← bracket90.coscad ×1 ▽top seam=rear material=petg

fixed railH 100 0 -10 0 0 0
mate railV @rail_end_railH railH @rail_end_railV
mate inner @foot_railH railH @foot_inner
mate inner @side_railV railV @side_inner
mate bracket1 @outer_bore_railH railH @outer_bore_bracket1 roll=180
mate bracket2 @outer_bore_railH railH @outer_bore_bracket2
