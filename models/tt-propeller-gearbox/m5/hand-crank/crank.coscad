// Five parallel axes, four 1:1 meshes. All dimensions in mm.
step = 33.2
span = 4 * step
length = span + 41
floor = box length 44 3 |> move (span / 2) 0 1.5
// Two M5 screws clamp the TT body against a slotted motor tongue.
tongue = box 46 48 3 |> move -34 0 1.5
mountSlot = (zcyl 2.8 8 |> x -46) |> hull (zcyl 2.8 8 |> x -32)
motorMount = tongue ⊖ (mountSlot |> y 18) ⊖ (mountSlot |> y -18)
mountHole = zcyl 2.8 12 |> z 3
bridge = (box 15 48 5 |> z 2.5) ⊖ (mountHole |> y 18) ⊖ (mountHole |> y -18)
inputBearing = zcyl 4.3 8 |> z 2
wall = box length 2.5 5.7 |> move (span / 2) 20.75 5.65
end = box 1.8 44 5.7 |> move -19.6 0 5.65
rim = wall ⊕ (wall |> y -41.5) ⊕ end ⊕ (end |> x (span + 39.2))
axle = zcyl 3 8 |> z 6
axles = (axle |> x step) ⊕ (axle |> x (2 * step)) ⊕ (axle |> x (3 * step))
shortPin = zcyl 2.2 2.8 |> move span 0 4
// Four M5 through-bolts and external nuts close the gear compartment.
corner = zcyl 5.2 8.5 |> anchor bot
ends = (corner |> move -15 18 0) ⊕ (corner |> move -15 -18 0) ⊕ (corner |> move (span + 15) 18 0) ⊕ (corner |> move (span + 15) -18 0)
bolt = zcyl 2.8 20 |> z 6
pair = (bolt |> y 18) ⊕ (bolt |> y -18)
holes = (pair |> x -15) ⊕ (pair |> x (span + 15))
base = (floor ⊕ motorMount ⊕ rim ⊕ axles ⊕ shortPin ⊕ ends) ⊖ inputBearing ⊖ holes
coverBlank = box length 44 3 |> move (span / 2) 0 1.5
axleHole = zcyl 3.25 6 |> z 1.5
cover = coverBlank ⊖ (pair |> x -15) ⊖ (pair |> x (span + 15)) ⊖ (axleHole |> x step) ⊖ (axleHole |> x (2 * step)) ⊖ (axleHole |> x (3 * step)) ⊖ (inputBearing |> x span)
gearBlank = ⮕ 4.8 (poly 14.6017 0.8258 15.4802 0.8755 15.8916 0.9640 16.2989 1.1090 16.7025 1.2933 17.1017 1.5111 17.4959 1.7596 17.8844 2.0365 17.7337 3.0846 17.2829 3.2409 16.8347 3.3682 16.3903 3.4648 15.9511 3.5279 15.5194 3.5522 15.0998 3.5212 14.2429 3.3214 13.7775 4.9061 14.6065 5.2013 14.9762 5.4021 15.3263 5.6560 15.6616 5.9465 15.9832 6.2680 16.2915 6.6175 16.5862 6.9926 16.1464 7.9558 15.6698 7.9788 15.2038 7.9746 14.7502 7.9421 14.3111 7.8789 13.8900 7.7807 13.4961 7.6327 12.7302 7.1995 11.8372 8.5890 12.5494 9.1057 12.8476 9.4026 13.1120 9.7448 13.3518 10.1180 13.5699 10.5171 13.7672 10.9392 13.9443 11.3823 13.2509 12.1825 12.7872 12.0702 12.3413 11.9350 11.9152 11.7760 11.5116 11.5917 11.1353 11.3787 10.7990 11.1258 10.1862 10.4944 8.9380 11.5760 9.4757 12.2725 9.6782 12.6413 9.8354 13.0441 9.9604 13.4698 10.0572 13.9142 10.1276 14.3748 10.1727 14.8498 9.2819 15.4222 8.8686 15.1839 8.4789 14.9285 8.1148 14.6559 7.7796 14.3653 7.4785 14.0550 7.2271 13.7176 6.8169 12.9391 5.3146 13.6252 5.6343 14.4450 5.7247 14.8559 5.7621 15.2867 5.7621 15.7303 5.7297 16.1840 5.6675 16.6458 5.5770 17.1142 4.5610 17.4126 4.2316 17.0674 3.9296 16.7125 3.6571 16.3484 3.4173 15.9752 3.2158 15.5926 3.0696 15.1980 2.8954 14.3355 1.2606 14.5706 1.3365 15.4472 1.3074 15.8670 1.2219 16.2909 1.0969 16.7165 0.9381 17.1427 0.7483 17.5682 0.5294 17.9922 -0.5294 17.9922 -0.7483 17.5682 -0.9381 17.1427 -1.0969 16.7165 -1.2219 16.2909 -1.3074 15.8670 -1.3365 15.4472 -1.2606 14.5706 -2.8954 14.3355 -3.0696 15.1980 -3.2158 15.5926 -3.4173 15.9752 -3.6571 16.3484 -3.9296 16.7125 -4.2316 17.0674 -4.5610 17.4126 -5.5770 17.1142 -5.6675 16.6458 -5.7297 16.1840 -5.7621 15.7303 -5.7621 15.2867 -5.7247 14.8559 -5.6343 14.4450 -5.3146 13.6252 -6.8169 12.9391 -7.2271 13.7176 -7.4785 14.0550 -7.7796 14.3653 -8.1148 14.6559 -8.4789 14.9285 -8.8686 15.1839 -9.2819 15.4222 -10.1727 14.8498 -10.1276 14.3748 -10.0572 13.9142 -9.9604 13.4698 -9.8354 13.0441 -9.6782 12.6413 -9.4757 12.2725 -8.9380 11.5760 -10.1862 10.4944 -10.7990 11.1258 -11.1353 11.3787 -11.5116 11.5917 -11.9152 11.7760 -12.3413 11.9350 -12.7872 12.0702 -13.2509 12.1825 -13.9443 11.3823 -13.7672 10.9392 -13.5699 10.5171 -13.3518 10.1180 -13.1120 9.7448 -12.8476 9.4026 -12.5494 9.1057 -11.8372 8.5890 -12.7302 7.1995 -13.4961 7.6327 -13.8900 7.7807 -14.3111 7.8789 -14.7502 7.9421 -15.2038 7.9746 -15.6698 7.9788 -16.1464 7.9558 -16.5862 6.9926 -16.2915 6.6175 -15.9832 6.2680 -15.6616 5.9465 -15.3263 5.6560 -14.9762 5.4021 -14.6065 5.2013 -13.7775 4.9061 -14.2429 3.3214 -15.0998 3.5212 -15.5194 3.5522 -15.9511 3.5279 -16.3903 3.4648 -16.8347 3.3682 -17.2829 3.2409 -17.7337 3.0846 -17.8844 2.0365 -17.4959 1.7596 -17.1017 1.5111 -16.7025 1.2933 -16.2989 1.1090 -15.8916 0.9640 -15.4802 0.8755 -14.6017 0.8258 -14.6017 -0.8258 -15.4802 -0.8755 -15.8916 -0.9640 -16.2989 -1.1090 -16.7025 -1.2933 -17.1017 -1.5111 -17.4959 -1.7596 -17.8844 -2.0365 -17.7337 -3.0846 -17.2829 -3.2409 -16.8347 -3.3682 -16.3903 -3.4648 -15.9511 -3.5279 -15.5194 -3.5522 -15.0998 -3.5212 -14.2429 -3.3214 -13.7775 -4.9061 -14.6065 -5.2013 -14.9762 -5.4021 -15.3263 -5.6560 -15.6616 -5.9465 -15.9832 -6.2680 -16.2915 -6.6175 -16.5862 -6.9926 -16.1464 -7.9558 -15.6698 -7.9788 -15.2038 -7.9746 -14.7502 -7.9421 -14.3111 -7.8789 -13.8900 -7.7807 -13.4961 -7.6327 -12.7302 -7.1995 -11.8372 -8.5890 -12.5494 -9.1057 -12.8476 -9.4026 -13.1120 -9.7448 -13.3518 -10.1180 -13.5699 -10.5171 -13.7672 -10.9392 -13.9443 -11.3823 -13.2509 -12.1825 -12.7872 -12.0702 -12.3413 -11.9350 -11.9152 -11.7760 -11.5116 -11.5917 -11.1353 -11.3787 -10.7990 -11.1258 -10.1862 -10.4944 -8.9380 -11.5760 -9.4757 -12.2725 -9.6782 -12.6413 -9.8354 -13.0441 -9.9604 -13.4698 -10.0572 -13.9142 -10.1276 -14.3748 -10.1727 -14.8498 -9.2819 -15.4222 -8.8686 -15.1839 -8.4789 -14.9285 -8.1148 -14.6559 -7.7796 -14.3653 -7.4785 -14.0550 -7.2271 -13.7176 -6.8169 -12.9391 -5.3146 -13.6252 -5.6343 -14.4450 -5.7247 -14.8559 -5.7621 -15.2867 -5.7621 -15.7303 -5.7297 -16.1840 -5.6675 -16.6458 -5.5770 -17.1142 -4.5610 -17.4126 -4.2316 -17.0674 -3.9296 -16.7125 -3.6571 -16.3484 -3.4173 -15.9752 -3.2158 -15.5926 -3.0696 -15.1980 -2.8954 -14.3355 -1.2606 -14.5706 -1.3365 -15.4472 -1.3074 -15.8670 -1.2219 -16.2909 -1.0969 -16.7165 -0.9381 -17.1427 -0.7483 -17.5682 -0.5294 -17.9922 0.5294 -17.9922 0.7483 -17.5682 0.9381 -17.1427 1.0969 -16.7165 1.2219 -16.2909 1.3074 -15.8670 1.3365 -15.4472 1.2606 -14.5706 2.8954 -14.3355 3.0696 -15.1980 3.2158 -15.5926 3.4173 -15.9752 3.6571 -16.3484 3.9296 -16.7125 4.2316 -17.0674 4.5610 -17.4126 5.5770 -17.1142 5.6675 -16.6458 5.7297 -16.1840 5.7621 -15.7303 5.7621 -15.2867 5.7247 -14.8559 5.6343 -14.4450 5.3146 -13.6252 6.8169 -12.9391 7.2271 -13.7176 7.4785 -14.0550 7.7796 -14.3653 8.1148 -14.6559 8.4789 -14.9285 8.8686 -15.1839 9.2819 -15.4222 10.1727 -14.8498 10.1276 -14.3748 10.0572 -13.9142 9.9604 -13.4698 9.8354 -13.0441 9.6782 -12.6413 9.4757 -12.2725 8.9380 -11.5760 10.1862 -10.4944 10.7990 -11.1258 11.1353 -11.3787 11.5116 -11.5917 11.9152 -11.7760 12.3413 -11.9350 12.7872 -12.0702 13.2509 -12.1825 13.9443 -11.3823 13.7672 -10.9392 13.5699 -10.5171 13.3518 -10.1180 13.1120 -9.7448 12.8476 -9.4026 12.5494 -9.1057 11.8372 -8.5890 12.7302 -7.1995 13.4961 -7.6327 13.8900 -7.7807 14.3111 -7.8789 14.7502 -7.9421 15.2038 -7.9746 15.6698 -7.9788 16.1464 -7.9558 16.5862 -6.9926 16.2915 -6.6175 15.9832 -6.2680 15.6616 -5.9465 15.3263 -5.6560 14.9762 -5.4021 14.6065 -5.2013 13.7775 -4.9061 14.2429 -3.3214 15.0998 -3.5212 15.5194 -3.5522 15.9511 -3.5279 16.3903 -3.4648 16.8347 -3.3682 17.2829 -3.2409 17.7337 -3.0846 17.8844 -2.0365 17.4959 -1.7596 17.1017 -1.5111 16.7025 -1.2933 16.2989 -1.1090 15.8916 -0.9640 15.4802 -0.8755 14.6017 -0.8258)
// Same module 1.5, 22-tooth involute used by the rack drive.
idler = gearBlank ⊖ (zcyl 3.25 8 |> z 2.4)
journal = zcyl 4 4.5 |> z 6.85
doubleD = (zcyl 2.85 12 ∩ box 4 7.7 12) |> z 4.5
driver = (gearBlank ⊕ journal) ⊖ doubleD
// Retain the original propeller bore. Two identical M5 collar halves key
// into a groove beyond the longest hub. Counter-orient their fasteners.
shaft = (zcyl 2.7 28.8 ∩ box 3.7 8 28.8) |> z 23.4
groove = (zcyl 4 2.6 ⊖ zcyl 1.68 4) |> z 32.4
output = (gearBlank ⊕ journal ⊕ (shaft ⊖ groove)) ⊖ (zcyl 2.48 3 |> z 1.2)
clampBore = zcyl 2.92 14 ∩ box 4.15 8 14
key = (zcyl 3.5 1.8 ⊖ zcyl 1.92 3) |> z 4
collarBlank = (box 12 28 9 |> z 4.5) ⊖ (clampBore |> z 4.5)
crossHole = xcyl 2.8 20 |> z 4.5
collarHalf = ((collarBlank ⊕ key) ∩ (box 5.85 29 11 |> move 3.075 0 4.5)) ⊖ (crossHole |> y 8.5) ⊖ (crossHole |> y -8.5)
halfPrint = collarHalf |> roty 90 |> anchor bot
spacer2 = (zcyl 4.4 2 |> z 1) ⊖ doubleD
spacer5 = (zcyl 4.4 5 |> z 2.5) ⊖ doubleD
gears = driver ⊕ (idler |> x 40) ⊕ (idler |> x 80) ⊕ (idler |> x 120) ⊕ (output |> x 160)
extras = (bridge |> move 6 146 0) ⊕ (halfPrint |> move 38 145 0) ⊕ (halfPrint |> move 60 145 0) ⊕ (spacer2 |> move 82 143 0) ⊕ (spacer5 |> move 98 143 0)
crankStub = (zcyl 2.65 6.7 ∩ box 3.6 7 20) |> z 4.949999999999999
crankJournal = zcyl 4 3.9000000000000012 |> z 10.049999999999999
crankCollar = zcyl 6 7.3999999999999995 |> z 15.5
crankArm = (zcyl 7 6 |> z 22) |> hull (zcyl 7 6 |> move 32 0 22)
crankScrewHole = zcyl 2.8 20 |> move 32 0 25 |> frame handleHole top top bak 0 0 -10
crankNutPocket = ⎏ 6 4.792 4.2 |> move 32 0 18.99 |> frame handleNut top bot bak
crank = (crankStub ⊕ crankJournal ⊕ crankCollar ⊕ crankArm) ⊖ crankScrewHole ⊖ crankNutPocket
crankSleeve = ((zcyl 4 16.5 |> z 33.25) ⊕ (zcyl 6.5 1.5 |> z 42.25) ⊖ (zcyl 2.75 40 |> z 25)) |> x 32 |> frame handleSeat top top bak
crankKnob = ((zcyl 8 16.1) ⊖ (zcyl 4.3 18.1)) |> move 32 0 33.25
crankCover = ((cover ⊖ inputBearing) ⊖ (bolt |> move -15 18 0 |> frame seatA top top bak 0 0 -13) ⊖ (bolt |> move -15 -18 0 |> frame seatB top top bak 0 0 -13) ⊖ (bolt |> move (span + 15) 18 0 |> frame seatC top top bak 0 0 -13) ⊖ (bolt |> move (span + 15) -18 0 |> frame seatD top top bak 0 0 -13)) |> z 8.5
framedBase = base ⊖ (bolt |> move -15 18 0 |> frame holeA top top bak 0 0 -7.5 |> frame nutA bot bot bak 0 0 4) ⊖ (bolt |> move -15 -18 0 |> frame holeB top top bak 0 0 -7.5 |> frame nutB bot bot bak 0 0 4) ⊖ (bolt |> move (span + 15) 18 0 |> frame holeC top top bak 0 0 -7.5 |> frame nutC bot bot bak 0 0 4) ⊖ (bolt |> move (span + 15) -18 0 |> frame holeD top top bak 0 0 -7.5 |> frame nutD bot bot bak 0 0 4)
placedDriver = driver |> roty 180 |> z 8
standRim = (box length 44 10 ⊖ box (length - 10) 34 12) |> move (span / 2) 0 -5
standPads = (zcyl 9 10 |> move -15 18 0) ⊕ (zcyl 9 10 |> move -15 -18 0) ⊕ (zcyl 9 10 |> move (span + 15) 18 0) ⊕ (zcyl 9 10 |> move (span + 15) -18 0) ⊕ zcyl 9 10 ⊕ box 6 44 10
standNut = ⎏ 6 4.792 4.21 |> z 0.7999999999999998
standClear = zcyl 3 12
standCuts = (zcyl 5.5 12) ⊕ (standNut |> move -15 18 0 |> frame holeA top top bak 0 0 -0.01 |> frame nutA top bot bak 0 0 -0.01) ⊕ (standClear |> move -15 18 0) ⊕ (standNut |> move -15 -18 0 |> frame holeB top top bak 0 0 -0.01 |> frame nutB top bot bak 0 0 -0.01) ⊕ (standClear |> move -15 -18 0) ⊕ (standNut |> move (span + 15) 18 0 |> frame holeC top top bak 0 0 -0.01 |> frame nutC top bot bak 0 0 -0.01) ⊕ (standClear |> move (span + 15) 18 0) ⊕ (standNut |> move (span + 15) -18 0 |> frame holeD top top bak 0 0 -0.01 |> frame nutD top bot bak 0 0 -0.01) ⊕ (standClear |> move (span + 15) -18 0)
crankStand = (standRim ⊕ (standPads |> z -5)) ⊖ (standCuts |> z -5)
main = crank
