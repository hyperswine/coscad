// Upright motor, seated from below against the underside of the front lip.
// Dimensions are in mm. The open rear slot clears the motor leads.
bodyWidth = 19.7
bodyDepth = 14.8
bodyLength = 29.4
seat = bodyLength + 2
socketOuter = box (bodyWidth + 4) (bodyDepth + 4) (seat + 1.2) |> move 0 0 ((seat + 1.2) / 2)
socketVoid = box (bodyWidth + 0.3) (bodyDepth + 0.3) (seat + 1) |> move 0 0 ((seat - 1) / 2)
bossOpening = zcyl 6 5 |> move 0 0 seat
wireSlot = box 5 6 (seat + 1) |> move 0 -8 ((seat - 1) / 2)
socket = socketOuter ⊖ socketVoid ⊖ bossOpening ⊖ wireSlot
grip = zcyl 0.55 23 |> move 10.25 0 15
rackFloor = seat + 1.8
foot = box 27 24 2 |> move 0 18 1
shelf = box 27 11.5 rackFloor |> move 0 24.75 (rackFloor / 2)
rail = box 22 3.05 4.35 |> move 0 24.7 (rackFloor + 2.175)
stud = zcyl 0.96 2.6 |> move 8 24.7 (rackFloor + 5.55)
base = (socket ⊕ foot ⊕ shelf ⊕ rail ⊕ stud ⊕ (stud |> move -16 0 0)) ⊖ socketVoid
// Restore the two narrow friction ribs inside the motor opening.
holder = base ⊕ grip ⊕ (grip |> move -20.5 0 0)
