// Build plan for the spiral launcher (coscad plan): end-of-stroke pose, no glider. Written by build.sol.
plate 256 256 6
base ← base.coscad ×1 ▽bot material=pla preload=hand
spring ← spring.coscad ×1 ▽bot material=pla
pinion ← pinion.coscad ×1 ▽bot material=pla
cap ← cap.coscad ×1 ▽bot material=pla
carriage ← carriage.coscad ×1 ▽bot material=pla
mast ← mast.coscad ×1 ▽fwd material=pla
beamRear ← beam221.coscad ×1 ▽bot profile=2020 material=pla
beamFront ← beam221.coscad ×1 ▽bot profile=2020 material=pla
footRear ← ../tank-model-2020/rail100.coscad ×1 ▽bot profile=2020 material=pla
footFront ← ../tank-model-2020/rail100.coscad ×1 ▽bot profile=2020 material=pla
brRearL ← corner-bracket.coscad ×1 ▽lft material=pla
brRearR ← corner-bracket.coscad ×1 ▽lft material=pla
brFrontL ← corner-bracket.coscad ×1 ▽lft material=pla
brFrontR ← corner-bracket.coscad ×1 ▽lft material=pla
splice ← splice.coscad ×1 ▽bak material=pla
stopRear ← stop.coscad ×1 ▽top material=pla
stopFront ← stop.coscad ×1 ▽top material=pla
guide ← stopper-guide.coscad ×1 ▽lft material=pla

fixed base 0 0 0 0 0 0
fixed spring 0 0 0 0 0 0
fixed cap 0 0 0 0 0 0
fixed pinion 0 0 0 0 0 0
fixed carriage 0 0 0 0 0 0
fixed mast 0 0 0 0 0 0
fixed beamRear -116.5 51 26.2 0 90 0
fixed beamFront 104.5 51 26.2 0 90 0
fixed footRear -116.5 51 6.2 90 0 0
fixed footFront 104.5 51 6.2 90 0 0
fixed brRearR -116.5 61 16.2 0 0 0
fixed brRearL -116.5 41 16.2 0 0 180
fixed brFrontR 104.5 61 16.2 0 0 0
fixed brFrontL 104.5 41 16.2 0 0 180
fixed splice 0 0 0 0 0 0
fixed guide 0 0 0 0 0 0
fixed stopRear -217 51 36.2 0 0 0
fixed stopFront 204 51 36.2 0 0 0

fastener M5x10 brRearR beamRear bak at=110.5 through=5 nut=dropin
fastener M5x10 brRearR footRear top at=73 through=5 nut=dropin
fastener M5x10 brRearL beamRear fwd at=110.5 through=5 nut=dropin
fastener M5x10 brRearL footRear top at=27 through=5 nut=dropin
fastener M5x10 brFrontR beamFront bak at=110.5 through=5 nut=dropin
fastener M5x10 brFrontR footFront top at=73 through=5 nut=dropin
fastener M5x10 brFrontL beamFront fwd at=110.5 through=5 nut=dropin
fastener M5x10 brFrontL footFront top at=27 through=5 nut=dropin
fastener M5x10 splice beamRear bak ×2 at=196,211 through=5 nut=dropin
fastener M5x10 splice beamFront bak ×2 at=10,25 through=5 nut=dropin
fastener M5x10 base beamRear fwd ×2 at=177,191 through=5 nut=dropin
fastener M5x10 base beamFront fwd ×2 at=62,76 through=5 nut=dropin
fastener M5x10 guide beamRear fwd ×2 at=46.5,59.5 through=5 nut=dropin
fastener M5x10 stopRear beamRear top at=10 through=5 nut=dropin
fastener M5x10 stopFront beamFront top at=210 through=5 nut=dropin
joint drop spring base axis=top
joint drop pinion spring axis=top
fastener M5x10 cap base @post seat=@cap nut=hex pocket=@post_nut
joint drop carriage beamFront axis=rt
joint push mast carriage axis=top
plan rest=bot
