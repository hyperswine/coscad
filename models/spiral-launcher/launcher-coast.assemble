// Carriage at the front stop (rack clear of the pinion), glider 100 mm on.
plate 256 256 6
base ← base.coscad ×1 ▽bot material=pla
spring ← spring.coscad ×1 ▽bot material=pla
pinion ← pinion.coscad ×1 ▽bot material=pla
cap ← cap.coscad ×1 ▽bot material=pla
carriage ← carriage.coscad ×1 ▽bot material=pla
mast ← mast.coscad ×1 ▽fwd material=pla
beamRear ← beam221.coscad ×1 ▽bot profile=2020 material=pla
beamFront ← beam221.coscad ×1 ▽bot profile=2020 material=pla
footRear ← ../tank-model-2020/rail100.coscad ×1 ▽bot profile=2020 material=pla
footFront ← ../tank-model-2020/rail100.coscad ×1 ▽bot profile=2020 material=pla
brRearL ← corner-bracket.coscad ×1 ▽lft material=pla
brRearR ← corner-bracket.coscad ×1 ▽lft material=pla
brFrontL ← corner-bracket.coscad ×1 ▽lft material=pla
brFrontR ← corner-bracket.coscad ×1 ▽lft material=pla
splice ← splice.coscad ×1 ▽bak material=pla
stopRear ← stop.coscad ×1 ▽top material=pla
stopFront ← stop.coscad ×1 ▽top material=pla
guide ← stopper-guide.coscad ×1 ▽lft material=pla
fuselage ← ../pla-bow-launcher/glider-fuselage.coscad ×1 ▽fwd material=pla
wing ← ../pla-bow-launcher/glider-wing.coscad ×1 ▽bot material=pla
stab ← ../pla-bow-launcher/glider-stab.coscad ×1 ▽bot material=pla
saddle ← ../pla-bow-launcher/glider-saddle.coscad ×1 ▽bot material=pla

fixed base 0 0 0 0 0 0
fixed spring 0 0 0 0 0 0
fixed cap 0 0 0 0 0 0
fixed pinion 0 0 0 0 0 -10.4174
fixed carriage 5 0 0 0 0 0
fixed mast 5 0 0 0 0 0
fixed beamRear -116.5 51 26.2 0 90 0
fixed beamFront 104.5 51 26.2 0 90 0
fixed footRear -116.5 51 6.2 90 0 0
fixed footFront 104.5 51 6.2 90 0 0
fixed brRearR -116.5 61 16.2 0 0 0
fixed brRearL -116.5 41 16.2 0 0 180
fixed brFrontR 104.5 61 16.2 0 0 0
fixed brFrontL 104.5 41 16.2 0 0 180
fixed splice 0 0 0 0 0 0
fixed guide 0 0 0 0 0 0
fixed stopRear -217 51 36.2 0 0 0
fixed stopFront 204 51 36.2 0 0 0
fixed fuselage 99.3 51 54 0 0 0
fixed saddle 99.3 51 54 0 0 0
fixed wing 72.6 51 66.3 0 -2 0
fixed stab -5.7 51 61.1 0 0 0
