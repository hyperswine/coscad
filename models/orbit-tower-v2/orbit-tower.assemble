// Named rigid interfaces; coordinate reference retained under test/fixtures/assemblies.
plate 256 256 7
base ← base.coscad ×1 ▽bot material=pla
axle1 ← axle.coscad ×1 ▽bot material=pla after=base
rotor1 ← rotor.coscad ×1 ▽bot material=pla
satellite1 ← satellite.coscad ×1 ▽bot material=pla
axle2 ← axle.coscad ×1 ▽bot material=pla after=rotor1
rotor2 ← rotor.coscad ×1 ▽bot material=pla
satellite2 ← satellite.coscad ×1 ▽bot material=pla
axle3 ← axle.coscad ×1 ▽bot material=pla after=rotor2
rotor3 ← rotor.coscad ×1 ▽bot material=pla
satellite3 ← satellite.coscad ×1 ▽bot material=pla
axle4 ← axle.coscad ×1 ▽bot material=pla after=rotor3
rotor4 ← rotor.coscad ×1 ▽bot material=pla
satellite4 ← satellite.coscad ×1 ▽bot material=pla
axle5 ← axle.coscad ×1 ▽bot material=pla after=rotor4
rotor5 ← rotor.coscad ×1 ▽bot material=pla
satellite5 ← satellite.coscad ×1 ▽bot material=pla
axle6 ← axle.coscad ×1 ▽bot material=pla after=rotor5
rotor6 ← rotor.coscad ×1 ▽bot material=pla
satellite6 ← satellite.coscad ×1 ▽bot material=pla
cap ← cap.coscad ×1 ▽bot material=pla after=rotor6

fixed base 0 0 0 0 0 0
mate axle1 @peg_seat_base base @peg_seat_axle1
mate rotor1 @peg_seat_axle1 axle1 @peg_seat_rotor1
mate satellite1 @peg_seat_rotor1 rotor1 @peg_seat_satellite1 roll=180
mate axle2 @peg_seat_base axle1 @peg_seat_axle2
mate rotor2 @peg_seat_axle1 axle2 @peg_seat_rotor1 roll=60
mate satellite2 @peg_seat_rotor1 rotor2 @peg_seat_satellite1 roll=180
mate axle3 @peg_seat_base axle2 @peg_seat_axle2
mate rotor3 @peg_seat_axle1 axle3 @peg_seat_rotor1 roll=120
mate satellite3 @peg_seat_rotor1 rotor3 @peg_seat_satellite1 roll=180
mate axle4 @peg_seat_base axle3 @peg_seat_axle2
mate rotor4 @peg_seat_axle1 axle4 @peg_seat_rotor1 roll=180
mate satellite4 @peg_seat_rotor1 rotor4 @peg_seat_satellite1 roll=180
mate axle5 @peg_seat_base axle4 @peg_seat_axle2
mate rotor5 @peg_seat_axle1 axle5 @peg_seat_rotor1 roll=-120
mate satellite5 @peg_seat_rotor1 rotor5 @peg_seat_satellite1 roll=180
mate axle6 @peg_seat_base axle5 @peg_seat_axle2
mate rotor6 @peg_seat_axle1 axle6 @peg_seat_rotor1 roll=-60
mate satellite6 @peg_seat_rotor1 rotor6 @peg_seat_satellite1 roll=180
mate cap @peg_seat_axle6 axle6 @peg_seat_axle2

fastener peg axle1 base top
fastener peg rotor1 axle1 top inset=13
fastener peg satellite1 rotor1 top
fastener peg axle2 axle1 top
fastener peg rotor2 axle2 top inset=13
fastener peg satellite2 rotor2 top
fastener peg axle3 axle2 top
fastener peg rotor3 axle3 top inset=13
fastener peg satellite3 rotor3 top
fastener peg axle4 axle3 top
fastener peg rotor4 axle4 top inset=13
fastener peg satellite4 rotor4 top
fastener peg axle5 axle4 top
fastener peg rotor5 axle5 top inset=13
fastener peg satellite5 rotor5 top
fastener peg axle6 axle5 top
fastener peg rotor6 axle6 top inset=13
fastener peg satellite6 rotor6 top
fastener peg cap axle6 top
plan rest=bot
