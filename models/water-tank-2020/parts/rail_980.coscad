// Tank study derivative: examples-next/rail_x180.coscad
// 2020 rail segment, 980mm, running along X, butts between Y rails (x0).
r = box 980 20 20
main = r
  |> cutat fwd (box 982 3.6 6.4)
  |> cutat bak (box 982 3.6 6.4)
  |> cutat top (box 982 6.4 3.6)
  |> cutat bot (box 982 6.4 3.6)
  |> cutat ctr 0 6.8 0 (box 982 2.8 9.5)
  |> cutat ctr 0 -6.8 0 (box 982 2.8 9.5)
  |> cutat ctr 0 0 6.8 (box 982 9.5 2.8)
  |> cutat ctr 0 0 -6.8 (box 982 9.5 2.8)
  |> cutat ctr (xcyl 2.1 982)

