// Tank study derivative: examples-next/bracket_seam.coscad
// Seam bracket (topological build, boolean-identical to bracket.coscad).
// Local frame: seam_bracket_plate back face x=-2.5, seam_bracket_key face x=-3.5, seam_bracket_flange tip x=13.5,
// z centered (rail height spans -10..10), y = along-rail (15 wide).
// Pose rule in the .assemble: rotate to face, translate face_axis by
// (rail_face_plane + 2.5), then lift z +10.
seam_bracket_plate  = box 5 15 20
seam_bracket_flange = box 16 15 5
seam_bracket_key    = box 1 15 5.8
seam_bracket_gusset = ⊿ 15 15 14.2 |> rotz -90 |> mirror 0 0 1

seam_bracket_main = seam_bracket_plate
  |> at top 5.5 0 -5 seam_bracket_flange
  |> at lft seam_bracket_key
  |> at ctr 1 0 -1.9 seam_bracket_gusset
  |> cutat lft 3.5 0 0 (xcyl 2.7 12)
  |> cutat rt -0.5 0 0 (xcyl 5.0 21)
  |> cutat top 2.5 0 -4 (zcyl 1.4 10)


