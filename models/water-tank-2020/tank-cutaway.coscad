// Generated review cutaway: front/right panels and small hardware omitted.
// Tank study derivative: examples/assemble/plan/flat90.coscad
// Flat 90-degree bracket, 40 x 40 x 6, with 20 mm wide legs.
// The missing quadrant is +X,+Y; holes align with 2020 rail centres.
// Centred cutters extend past both faces to make true through holes.
flat_connector_main = box 40 40 6
  |> cut (box 20 20 8 |> move 10 10 0)
  |> cut (zcyl 2.75 10 |> move 10 -10 0)
  |> cut (zcyl 2.75 10 |> move -10 10 0)


// Tank study derivative: examples-next/corner_90.coscad
// 90-degree corner connector, crude preview solid (x0 hardware).
// Plan-view L: inside_corner_legA presses a +Y rail face, inside_corner_legB presses a +X rail face.
// M5 clearance d5.5 in each leg, 10mm from the inside corner.
inside_corner_legA = box 17 4 18
inside_corner_legB = box 4 13 18
inside_corner_main = inside_corner_legA
  |> at rt -4 -4.5 0 inside_corner_legB
  |> cutat ctr -1.5 4.5 0 (ycyl 2.75 8)
  |> cutat ctr 6.5 -3.5 0 (xcyl 2.75 8)


