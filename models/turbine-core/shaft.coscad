// Shaft: 8 mm, 130 long, 10 mm bearing seats at z 6-18 and z 102-114; prints standing, four mouse-ear pads.
core = (zcyl 4 130 |> move 0 0 65) ⊕ (zcyl 5 12 |> move 0 0 12) ⊕ (zcyl 5 12 |> move 0 0 108)
pads = (ω 0.0 (χ 8 (⚓ bot (zcyl 4 0.2)))) ⊕ (ω 90.0 (χ 8 (⚓ bot (zcyl 4 0.2)))) ⊕ (ω 180.0 (χ 8 (⚓ bot (zcyl 4 0.2)))) ⊕ (ω 270.0 (χ 8 (⚓ bot (zcyl 4 0.2))))
main = core ⊕ pads
