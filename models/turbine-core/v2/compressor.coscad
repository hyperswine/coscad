// Centrifugal compressor wheel: inlet up (+Z), back disc on the plate. Axial inlet at the nose, radial outlet at r30.
// 7 backswept blades (38 deg wrap), hub profile z = 4 + 20 (1-u)^2, u = (r-7)/23. Bore r4.05 for the 8 mm shaft.
hub = ((zcyl 7.000 24.000 |> move 0 0 12.000) ⇓ (zcyl 9.875 19.312 |> move 0 0 9.656)) ⊕ ((zcyl 9.875 19.312 |> move 0 0 9.656) ⇓ (zcyl 12.750 15.250 |> move 0 0 7.625)) ⊕ ((zcyl 12.750 15.250 |> move 0 0 7.625) ⇓ (zcyl 15.625 11.812 |> move 0 0 5.906)) ⊕ ((zcyl 15.625 11.812 |> move 0 0 5.906) ⇓ (zcyl 18.500 9.000 |> move 0 0 4.500)) ⊕ ((zcyl 18.500 9.000 |> move 0 0 4.500) ⇓ (zcyl 21.375 6.812 |> move 0 0 3.406)) ⊕ ((zcyl 21.375 6.812 |> move 0 0 3.406) ⇓ (zcyl 24.250 5.250 |> move 0 0 2.625)) ⊕ ((zcyl 24.250 5.250 |> move 0 0 2.625) ⇓ (zcyl 27.125 4.312 |> move 0 0 2.156)) ⊕ ((zcyl 27.125 4.312 |> move 0 0 2.156) ⇓ (zcyl 30.000 4.000 |> move 0 0 2.000))
blade = ((ω 0.47 (χ 8.000 (ζ 22.968 (box 2.2 1.6 3.339)))) ⇓ (ω 3.00 (χ 10.750 (ζ 21.582 (box 2.2 1.6 9.144))))) ⊕ ((ω 3.00 (χ 10.750 (ζ 21.582 (box 2.2 1.6 9.144)))) ⇓ (ω 6.48 (χ 13.500 (ζ 18.804 (box 2.2 1.6 11.022))))) ⊕ ((ω 6.48 (χ 13.500 (ζ 18.804 (box 2.2 1.6 11.022)))) ⇓ (ω 10.62 (χ 16.250 (ζ 15.240 (box 2.2 1.6 10.185))))) ⊕ ((ω 10.62 (χ 16.250 (ζ 15.240 (box 2.2 1.6 10.185)))) ⇓ (ω 15.28 (χ 19.000 (ζ 12.249 (box 2.2 1.6 9.348))))) ⊕ ((ω 15.28 (χ 19.000 (ζ 12.249 (box 2.2 1.6 9.348)))) ⇓ (ω 20.40 (χ 21.750 (ζ 9.829 (box 2.2 1.6 8.511))))) ⊕ ((ω 20.40 (χ 21.750 (ζ 9.829 (box 2.2 1.6 8.511)))) ⇓ (ω 25.92 (χ 24.500 (ζ 7.981 (box 2.2 1.6 7.674))))) ⊕ ((ω 25.92 (χ 24.500 (ζ 7.981 (box 2.2 1.6 7.674)))) ⇓ (ω 31.80 (χ 27.250 (ζ 6.704 (box 2.2 1.6 6.837))))) ⊕ ((ω 31.80 (χ 27.250 (ζ 6.704 (box 2.2 1.6 6.837)))) ⇓ (ω 38.00 (χ 30.000 (ζ 6.000 (box 2.2 1.6 6.000)))))
blades = (ω 0.000 blade) ⊕ (ω 51.429 blade) ⊕ (ω 102.857 blade) ⊕ (ω 154.286 blade) ⊕ (ω 205.714 blade) ⊕ (ω 257.143 blade) ⊕ (ω 308.571 blade)
main = ((hub ⊕ blades) ⊖ (zcyl 4.05 40 |> move 0 0 12))
