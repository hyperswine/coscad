// Dimensions in mm. Print upright, flat base on the bed; no supports.
// Open top pocket for a coin up to 25 mm diameter and 3 mm thick.
height = 50
radius = 15
slot_length = 25.6
slot_width = 3.6
slot_depth = 26
body = ◎ radius height
// Plain glyph box is corner anchored; extend cutter 1 mm above the top.
slot = χ (0 - slot_length / 2) (ψ (0 - slot_width / 2) (ζ (height - slot_depth) (▬ slot_length slot_width (slot_depth + 1))))
main = body ⊖ slot
