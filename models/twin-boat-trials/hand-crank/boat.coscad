// Small floating boat, mm. Open cavities require no trapped support.
outer = (ζ 0 (⮕ 0.02 (✎ -46 -5.4 -46 -8.28 -41.4 -9 -32.2 -9 -18.4 -9 0 -9 13.8 -9 32.2 -8.64 44.16 -3.24 46 0 44.16 3.24 32.2 8.64 13.8 9 0 9 -18.4 9 -32.2 9 -41.4 9 -46 8.28 -46 5.4 -46 1.8 -46 -1.8 -46 -5.4))) ⇓ (ζ 3 (⮕ 0.02 (✎ -48 -6.6 -48 -10.12 -43.2 -11 -33.6 -11 -19.2 -11 0 -11 14.4 -11 33.6 -10.56 46.08 -3.96 48 0 46.08 3.96 33.6 10.56 14.4 11 0 11 -19.2 11 -33.6 11 -43.2 11 -48 10.12 -48 6.6 -48 2.2 -48 -2.2 -48 -6.6))) ⇓ (ζ 15 (⮕ 0.02 (✎ -54 -13.8 -54 -21.16 -48.6 -23 -37.8 -23 -21.6 -23 0 -23 16.2 -23 37.8 -22.08 51.84 -8.28 54 0 51.84 8.28 37.8 22.08 16.2 23 0 23 -21.6 23 -37.8 23 -48.6 23 -54 21.16 -54 13.8 -54 4.6 -54 -4.6 -54 -13.8))) ⇓ (ζ 28 (⮕ 0.02 (✎ -58 -16.2 -58 -24.84 -52.2 -27 -40.6 -27 -23.2 -27 0 -27 17.4 -27 40.6 -25.92 55.68 -9.72 58 0 55.68 9.72 40.6 25.92 17.4 27 0 27 -23.2 27 -40.6 27 -52.2 27 -58 24.84 -58 16.2 -58 5.4 -58 -5.4 -58 -16.2)))
void = (ζ 6 (⮕ 0.02 (✎ -43.5 -4.8 -43.5 -7.36 -39.15 -8 -30.45 -8 -17.4 -8 0 -8 13.05 -8 30.45 -7.68 41.76 -2.88 43.5 0 41.76 2.88 30.45 7.68 13.05 8 0 8 -17.4 8 -30.45 8 -39.15 8 -43.5 7.36 -43.5 4.8 -43.5 1.6 -43.5 -1.6 -43.5 -4.8))) ⇓ (ζ 16 (⮕ 0.02 (✎ -50.5 -11.7 -50.5 -17.94 -45.45 -19.5 -35.35 -19.5 -20.2 -19.5 0 -19.5 15.15 -19.5 35.35 -18.72 48.48 -7.02 50.5 0 48.48 7.02 35.35 18.72 15.15 19.5 0 19.5 -20.2 19.5 -35.35 19.5 -45.45 19.5 -50.5 17.94 -50.5 11.7 -50.5 3.9 -50.5 -3.9 -50.5 -11.7))) ⇓ (ζ 28.3 (⮕ 0.02 (✎ -55 -14.4 -55 -22.08 -49.5 -24 -38.5 -24 -22 -24 0 -24 16.5 -24 38.5 -23.04 52.8 -8.64 55 0 52.8 8.64 38.5 23.04 16.5 24 0 24 -22 24 -38.5 24 -49.5 24 -55 22.08 -55 14.4 -55 4.8 -55 -4.8 -55 -14.4)))
originalHull = outer ⊖ void
point = box 0.04 0.04 0.04
outerRoot = (point |> move 9.65 -1.48 12) |> hull (point |> move 9.65 1.48 12)
outerTip = (point |> move 13.45 -0.58 12) |> hull (point |> move 13.45 0.58 12)
outerTooth = outerRoot |> hull outerTip
innerRoot = (point |> move 6.03 -0.925 7.5) |> hull (point |> move 6.03 0.925 7.5)
innerTip = (point |> move 8.41 -0.363 7.5) |> hull (point |> move 8.41 0.363 7.5)
inner = innerRoot |> hull innerTip
tooth = inner |> hull outerTooth
two = tooth ⊕ (tooth |> rotz 22.5)
four = two ⊕ (two |> rotz 45)
eight = four ⊕ (four |> rotz 90)
teeth = eight ⊕ (eight |> rotz 180)
cone = frustum 6.16 9.86 4.5 |> z 7.5
miter = teeth ⊕ cone
// Common gear apex at (-10,0,24). Local X points aft/down after installation.
// Each 4 x 6 x 6 mm plain bearing seats against its own shoulder.
tubeOuter = xcyl 4.8 55 |> x 48
greaseBore = xcyl 2.8 58 |> x 48
seatIn = xcyl 3.05 6.2 |> x 23.5
seatOut = xcyl 3.05 6.2 |> x 72.5
passage = greaseBore ⊕ seatIn ⊕ seatOut
post = zcyl 4.6 36 |> move 0 19.5 -3
pilot = zcyl 2.1 13 |> move 0 19.5 -15
posts = (post ⊕ (post |> y -39)) ⊖ pilot ⊖ (pilot |> y -39)
installedPosts = (posts |> roty 160 |> move -10 0 24)
// Keep the hull exterior smooth beneath the mounting posts.
pillars = installedPosts ∩ (outer ⊕ (box 70 54 50 |> move -10 0 53))
sternTube = tubeOuter ⊖ passage
gland = xcyl 6.5 11 |> x 42.5 |> roty 160 |> move -10 0 24
socketCut = xcyl 4.95 59 |> x 48 |> roty 160 |> move -10 0 24
hull = (originalHull ⊕ pillars ⊕ gland) ⊖ socketCut
// Detachable crank bearing bridge, counters screw into the printed posts.
bridgeSolid = box 11 49 5 |> move 0 0 -23.5
bridge = bridgeSolid ⊖ (zcyl 3.3 8 |> z -23.5) ⊖ (zcyl 2.75 8 |> move 0 19.5 -23.5) ⊖ (zcyl 2.75 8 |> move 0 -19.5 -23.5)
// Drive spindle prints integral with gear. Removable crank traps it axially.
stem = zcyl 3 14.3 |> z 18.95
key = (zcyl 3 9 ∩ box 4.5 7 9) |> z 30.35
thrust = zcyl 4.7 8.85 |> z 16.225
drive = miter ⊕ thrust ⊕ stem ⊕ key
crankBoss = zcyl 6 8 |> z 4
lever = (zcyl 5 4 |> z 2) |> hull (zcyl 4 4 |> move 25 0 2)
handle = zcyl 3.6 14 |> move 25 0 9
keyHole = (zcyl 3.17 12 ∩ box 4.8 8 12) |> z 4
// M3 radial set screws run in tapped 2.5 mm pilot holes.
crank = (crankBoss ⊕ lever ⊕ handle) ⊖ keyHole ⊖ (ycyl 1.25 8 |> move 0 4 5)
gearHub = zcyl 6 8.7 |> z 15.85
rodHole = zcyl 2.08 100
radialPilot = ycyl 1.25 8 |> move 0 4 16
shaftGear = (miter ⊕ gearHub) ⊖ rodHole ⊖ radialPilot
originalProp = (((zcyl 6 14 |> move 0 0 7)) ⊕ (ζ 7 ((ω 0 (((χ 5.2 (θ 61.4298 (box 0.05 11.25 2.4))) ⇓ (χ 7.675 (θ 51.2103 (box 0.05 12.6837 2.2375)))) ⊕ ((χ 7.675 (θ 51.2103 (box 0.05 12.6837 2.2375))) ⇓ (χ 10.15 (θ 43.2534 (box 0.05 13.8772 2.075)))) ⊕ ((χ 10.15 (θ 43.2534 (box 0.05 13.8772 2.075))) ⇓ (χ 12.625 (θ 37.1031 (box 0.05 14.5836 1.9125)))) ⊕ ((χ 12.625 (θ 37.1031 (box 0.05 14.5836 1.9125))) ⇓ (χ 15.1 (θ 32.3094 (box 0.05 14.5781 1.75)))) ⊕ ((χ 15.1 (θ 32.3094 (box 0.05 14.5781 1.75))) ⇓ (χ 17.575 (θ 28.5172 (box 0.05 13.7042 1.5875)))) ⊕ ((χ 17.575 (θ 28.5172 (box 0.05 13.7042 1.5875))) ⇓ (χ 20.05 (θ 25.4673 (box 0.05 11.9223 1.425)))) ⊕ ((χ 20.05 (θ 25.4673 (box 0.05 11.9223 1.425))) ⇓ (χ 22.525 (θ 22.9741 (box 0.05 9.339 1.2625)))) ⊕ ((χ 22.525 (θ 22.9741 (box 0.05 9.339 1.2625))) ⇓ (χ 25 (θ 20.9055 (box 0.05 6.1875 1.1)))))) ⊕ (ω 120 (((χ 5.2 (θ 61.4298 (box 0.05 11.25 2.4))) ⇓ (χ 7.675 (θ 51.2103 (box 0.05 12.6837 2.2375)))) ⊕ ((χ 7.675 (θ 51.2103 (box 0.05 12.6837 2.2375))) ⇓ (χ 10.15 (θ 43.2534 (box 0.05 13.8772 2.075)))) ⊕ ((χ 10.15 (θ 43.2534 (box 0.05 13.8772 2.075))) ⇓ (χ 12.625 (θ 37.1031 (box 0.05 14.5836 1.9125)))) ⊕ ((χ 12.625 (θ 37.1031 (box 0.05 14.5836 1.9125))) ⇓ (χ 15.1 (θ 32.3094 (box 0.05 14.5781 1.75)))) ⊕ ((χ 15.1 (θ 32.3094 (box 0.05 14.5781 1.75))) ⇓ (χ 17.575 (θ 28.5172 (box 0.05 13.7042 1.5875)))) ⊕ ((χ 17.575 (θ 28.5172 (box 0.05 13.7042 1.5875))) ⇓ (χ 20.05 (θ 25.4673 (box 0.05 11.9223 1.425)))) ⊕ ((χ 20.05 (θ 25.4673 (box 0.05 11.9223 1.425))) ⇓ (χ 22.525 (θ 22.9741 (box 0.05 9.339 1.2625)))) ⊕ ((χ 22.525 (θ 22.9741 (box 0.05 9.339 1.2625))) ⇓ (χ 25 (θ 20.9055 (box 0.05 6.1875 1.1)))))) ⊕ (ω 240 (((χ 5.2 (θ 61.4298 (box 0.05 11.25 2.4))) ⇓ (χ 7.675 (θ 51.2103 (box 0.05 12.6837 2.2375)))) ⊕ ((χ 7.675 (θ 51.2103 (box 0.05 12.6837 2.2375))) ⇓ (χ 10.15 (θ 43.2534 (box 0.05 13.8772 2.075)))) ⊕ ((χ 10.15 (θ 43.2534 (box 0.05 13.8772 2.075))) ⇓ (χ 12.625 (θ 37.1031 (box 0.05 14.5836 1.9125)))) ⊕ ((χ 12.625 (θ 37.1031 (box 0.05 14.5