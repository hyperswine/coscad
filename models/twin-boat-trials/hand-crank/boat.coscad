// A short boss aft of the blades gives unobstructed set-screw access.
prop = (originalProp ⊕ (zcyl 4.7 20 |> z 10)) ⊖ rodHole ⊖ (ycyl 1.25 8 |> move 0 4 17)
main = (hull |> anchor bot) ⊕ (sternTube |> roty -90 |> move 74 36 -20.5) ⊕ (bridge |> move 74 0 26) ⊕ (drive |> move 95 10 -7.48) ⊕ (shaftGear |> move 94 -21 -7.48) ⊕ (crank |> move -46 47 0) ⊕ (prop |> move 22 58 0)
