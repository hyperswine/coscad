agvn = (χ 0 glyphA) ⊕ (χ 4 glyphG) ⊕ (χ 8 glyphV) ⊕ (χ 12 glyphN)
benchy = (χ 0 glyphB) ⊕ (χ 4 glyphE) ⊕ (χ 8 glyphN) ⊕ (χ 13 glyphC) ⊕ (χ 17 glyphH) ⊕ (χ 21 glyphY)
// Root and mast share a centerline. Both tapers overlap the closed deck.
mast = χ -23 (ζ 27 ((◎ 4.2 0.2) ⇓ (ζ 67.8 (◎ 2.8 0.2))))
root = χ -23 (ζ 26 ((◎ 8 0.2) ⇓ (ζ 13.8 (◎ 3.9 0.2))))
// A 45-degree foot supports each new row. Broad upper field carries the lettering.
flag = χ -23 (ψ 1.2 (ζ 33 (θ 90 (⮕ 2.4 (✎ 0 0 45 45 45 60 0 60)))))
// The flag outline is a Bezier pennant (it reaches x = 10.75); the label fits inside it with 1.5 mm clear.
flagLabel = χ -18.2 (ψ -0.9 (ζ 75 (θ 90 (⬈ 1.66 1.66 1 agvn))))
hullLabel = χ -24 (ψ -24.15 (ζ 19 (θ 107.1 benchy)))
greenLetters = flagLabel ⊕ hullLabel
blackBody = (outer ⊕ root ⊕ mast ⊕ flag) ⊖ greenLetters
main = blackBody ⊕ greenLetters
