outer = (ζ 0 (⮕ 0.02 (✎ -46 -5.4 -46 -8.28 -41.4 -9 -32.2 -9 -18.4 -9 0 -9 13.8 -9 32.2 -8.64 44.16 -3.24 46 0 44.16 3.24 32.2 8.64 13.8 9 0 9 -18.4 9 -32.2 9 -41.4 9 -46 8.28 -46 5.4 -46 1.8 -46 -1.8 -46 -5.4))) ⇓ (ζ 3 (⮕ 0.02 (✎ -48 -6.6 -48 -10.12 -43.2 -11 -33.6 -11 -19.2 -11 0 -11 14.4 -11 33.6 -10.56 46.08 -3.96 48 0 46.08 3.96 33.6 10.56 14.4 11 0 11 -19.2 11 -33.6 11 -43.2 11 -48 10.12 -48 6.6 -48 2.2 -48 -2.2 -48 -6.6))) ⇓ (ζ 15 (⮕ 0.02 (✎ -54 -13.8 -54 -21.16 -48.6 -23 -37.8 -23 -21.6 -23 0 -23 16.2 -23 37.8 -22.08 51.84 -8.28 54 0 51.84 8.28 37.8 22.08 16.2 23 0 23 -21.6 23 -37.8 23 -48.6 23 -54 21.16 -54 13.8 -54 4.6 -54 -4.6 -54 -13.8))) ⇓ (ζ 28 (⮕ 0.02 (✎ -58 -16.2 -58 -24.84 -52.2 -27 -40.6 -27 -23.2 -27 0 -27 17.4 -27 40.6 -25.92 55.68 -9.72 58 0 55.68 9.72 40.6 25.92 17.4 27 0 27 -23.2 27 -40.6 27 -52.2 27 -58 24.84 -58 16.2 -58 5.4 -58 -5.4 -58 -16.2)))
glyphA = (χ 1 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 3 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 0 (▬ 1 1 0.9)))
glyphG = (χ 0 (ψ 4 (▬ 3 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 2 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 3 1 0.9)))
glyphV = (χ 0 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 2 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 1 (ψ 0 (▬ 1 1 0.9)))
glyphN = (χ 0 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 3 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 2 1 0.9))) ⊕ (χ 3 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 2 (▬ 2 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 3 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 1 1 0.9))) ⊕ (χ 3 (ψ 0 (▬ 1 1 0.9)))
glyphB = (χ 0 (ψ 4 (▬ 2 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 2 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 2 1 0.9)))
glyphE = (χ 0 (ψ 4 (▬ 3 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 2 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 3 1 0.9)))
glyphC = (χ 0 (ψ 4 (▬ 3 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 3 1 0.9)))
glyphH = (χ 0 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 4 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 3 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 2 (▬ 3 1 0.9))) ⊕ (χ 0 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 1 (▬ 1 1 0.9))) ⊕ (χ 0 (ψ 0 (▬ 1 1 0.9))) ⊕ (χ 2 (ψ 0 (▬ 1 1 0.9)))
