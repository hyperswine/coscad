// Root and mast share a centerline. Both tapers overlap the closed deck.
mast = χ -23 (ζ 27 ((◎ 4.2 0.2) ⇓ (ζ 67.8 (◎ 2.8 0.2))))
root = χ -23 (ζ 26 ((◎ 8 0.2) ⇓ (ζ 13.8 (◎ 3.9 0.2))))
// A 45-degree foot supports each new row. Broad upper field carries the lettering.
flag = χ -23 (ψ 1.2 (ζ 33 (θ 90 (⮕ 2.4 (✎ 0 0 45 45 45 60 0 60)))))
// Labels are inlaid flush: each is extruded from the inlay depth below the surface to 0.4 mm above it;
// green keeps the part inside the solid, black loses it. Hull side plane: y = -23 at z 15 to y = -27 at z 28.
flagLabel = χ -17.02 (ψ -1.2 (ζ 75 (θ 90 (ζ -1 (⬈ 1 1 1.4 agvn)))))
hullLabel = χ -29.5 (ψ -23.82 (ζ 17.68 (θ 107.1 (ζ -1.2 (⬈ 1 1 1.6 benchy)))))
solid = outer ⊕ root ⊕ mast ⊕ flag
labels = flagLabel ⊕ hullLabel
greenLetters = solid ∩ labels
blackBody = solid ⊖ labels
main = blackBody
