outer = (ζ 0 (⮕ 0.02 (✎ -46 -5.4 -46 -8.28 -41.4 -9 -32.2 -9 -18.4 -9 0 -9 13.8 -9 32.2 -8.64 44.16 -3.24 46 0 44.16 3.24 32.2 8.64 13.8 9 0 9 -18.4 9 -32.2 9 -41.4 9 -46 8.28 -46 5.4 -46 1.8 -46 -1.8 -46 -5.4))) ⇓ (ζ 3 (⮕ 0.02 (✎ -48 -6.6 -48 -10.12 -43.2 -11 -33.6 -11 -19.2 -11 0 -11 14.4 -11 33.6 -10.56 46.08 -3.96 48 0 46.08 3.96 33.6 10.56 14.4 11 0 11 -19.2 11 -33.6 11 -43.2 11 -48 10.12 -48 6.6 -48 2.2 -48 -2.2 -48 -6.6))) ⇓ (ζ 15 (⮕ 0.02 (✎ -54 -13.8 -54 -21.16 -48.6 -23 -37.8 -23 -21.6 -23 0 -23 16.2 -23 37.8 -22.08 51.84 -8.28 54 0 51.84 8.28 37.8 22.08 16.2 23 0 23 -21.6 23 -37.8 23 -48.6 23 -54 21.16 -54 13.8 -54 4.6 -54 -4.6 -54 -13.8))) ⇓ (ζ 28 (⮕ 0.02 (✎ -58 -16.2 -58 -24.84 -52.2 -27 -40.6 -27 -23.2 -27 0 -27 17.4 -27 40.6 -25.92 55.68 -9.72 58 0 55.68 9.72 40.6 25.92 17.4 27 0 27 -23.2 27 -40.6 27 -52.2 27 -58 24.84 -58 16.2 -58 5.4 -58 -5.4 -58 -16.2)))
// Lettering: closed stroke outlines from x2d-light/letters.py (8 mm tall, 1.4 mm strokes), one island per glyph.
glyphA = (⮕ 1 (poly 5.0000 0.0000 3.6000 0.0000 3.6000 2.9000 1.4000 2.9000 1.4000 0.0000 0.0000 0.0000 0.0000 5.9899 2.0101 8.0000 2.9899 8.0000 5.0000 5.9899)) ⊖ (ζ -0.1 (⮕ 1.2 (poly 3.6000 5.4101 2.5000 6.5101 1.4000 5.4101 1.4000 4.3000 3.6000 4.3000)))
glyphB = (⮕ 1 (poly 0.0000 8.0000 2.9899 8.0000 5.0000 5.9899 5.0000 4.5101 4.4899 4.0000 5.0000 3.4899 5.0000 2.0101 2.9899 0.0000 0.0000 0.0000)) ⊖ (ζ -0.1 (⮕ 1.2 (poly 1.4000 1.4000 2.4101 1.4000 3.6000 2.5899 3.6000 2.9101 3.2101 3.3000 1.4000 3.3000))) ⊖ (ζ -0.1 (⮕ 1.2 (poly 3.6000 5.0899 3.6000 5.4101 2.4101 6.6000 1.4000 6.6000 1.4000 4.7000 3.2101 4.7000)))
glyphC = (⮕ 1 (poly 1.4000 5.4101 1.4000 2.5899 2.5899 1.4000 5.0000 1.4000 5.0000 0.0000 2.0101 0.0000 0.0000 2.0101 0.0000 5.9899 2.0101 8.0000 5.0000 8.0000 5.0000 6.6000 2.5899 6.6000))
glyphE = (⮕ 1 (poly 4.4000 3.3000 1.4000 3.3000 1.4000 1.4000 5.0000 1.4000 5.0000 0.0000 0.0000 0.0000 0.0000 8.0000 5.0000 8.0000 5.0000 6.6000 1.4000 6.6000 1.4000 4.7000 4.4000 4.7000))
glyphG = (⮕ 1 (poly 1.4000 5.4101 1.4000 2.5899 2.5899 1.4000 3.6000 1.4000 3.6000 3.3000 2.1000 3.3000 2.1000 4.7000 5.0000 4.7000 5.0000 0.0000 2.0101 0.0000 0.0000 2.0101 0.0000 5.9899 2.0101 8.0000 5.0000 8.0000 5.0000 6.6000 2.5899 6.6000))
glyphH = (⮕ 1 (poly 1.4000 4.7000 3.6000 4.7000 3.6000 8.0000 5.0000 8.0000 5.0000 0.0000 3.6000 0.0000 3.6000 3.3000 1.4000 3.3000 1.4000 0.0000 0.0000 0.0000 0.0000 8.0000 1.4000 8.0000))
glyphN = (⮕ 1 (poly 1.4000 7.4785 3.6000 3.4452 3.6000 8.0000 5.0000 8.0000 5.0000 0.0000 3.6000 0.0000 3.6000 0.5215 1.4000 4.5548 1.4000 0.0000 0.0000 0.0000 0.0000 8.0000 1.4000 8.0000))
glyphV = (⮕ 1 (poly 2.5000 2.1618 3.6000 4.1785 3.6000 8.0000 5.0000 8.0000 5.0000 3.8215 2.9155 0.0000 2.0845 0.0000 0.0000 3.8215 0.0000 8.0000 1.4000 8.0000 1.4000 4.1785))
glyphY = (⮕ 1 (poly 1.8000 3.8498 0.0000 7.8498 0.0000 8.0000 1.4676 8.0000 2.5000 5.7058 3.5324 8.0000 5.0000 8.0000 5.0000 7.8498 3.2000 3.8498 3.2000 0.0000 1.8000 0.0000))
agvn = (χ 0 glyphA) ⊕ (χ 6.4 glyphG) ⊕ (χ 12.8 glyphV) ⊕ (χ 19.2 glyphN)
benchy = (χ 0 glyphB) ⊕ (χ 6.4 glyphE) ⊕ (χ 12.8 glyphN) ⊕ (χ 19.2 glyphC) ⊕ (χ 25.6 glyphH) ⊕ (χ 32 glyphY)
// Root and mast share a centerline. Both tapers overlap the closed deck.
mast = χ -23 (ζ 27 ((◎ 4.2 0.2) ⇓ (ζ 67.8 (◎ 2.8 0.2))))
root = χ -23 (ζ 26 ((◎ 8 0.2) ⇓ (ζ 13.8 (◎ 3.9 0.2))))
// A 45-degree foot supports each new row. Broad upper field carries the lettering.
flag = χ -23 (ψ 1.2 (ζ 33 (θ 90 (⮕ 2.4 (✎ 0 0 45 45 45 60 0 60)))))
// Labels are inlaid flush: each is extruded from the inlay depth below the surface to 0.4 mm above it;
// green keeps the part inside the solid, black loses it. Hull side plane: y = -23 at z 15 to y = -27 at z 28.
flagLabel = χ -17.02 (ψ -1.2 (ζ 75 (θ 90 (ζ -1 (⬈ 1 1 1.4 agvn)))))
hullLabel = χ -29.5 (ψ -23.82 (ζ 17.68 (θ 107.1 (ζ -1.2 (⬈ 1 1 1.6 benchy)))))
solid = outer ⊕ root ⊕ mast ⊕ flag
labels = flagLabel ⊕ hullLabel
greenLetters = solid ∩ labels
blackBody = solid ⊖ labels
main = greenLetters
