// One-piece Mk3 light. Construction coordinates in mm, scaled for the bed.
// Y runs aft and Z runs up.

// --- fuselage: piecewise hulls of spheres (round cross-sections) ---
// nose tip r2.5 @-128, max section r9 @-95, mid r7 @-15, boom r3.5 @+70, tail r2.5 @+126
fnose = ψ -128 (● 2.5)
fmax  = ψ -95 (● 9)
fmid  = ψ -15 (● 7)
fboom = ψ 70 (● 3.5)
ftail = ψ 126 (● 2.5)
fuse  = (fnose ⇓ fmax) ⊕ (fmax ⇓ fmid) ⊕ (fmid ⇓ fboom) ⊕ (fboom ⇓ ftail)

// --- right wing: 3mm plate = hull of 3 short posts (delta, tips at TE) ---
// root LE y-40, root TE y+45 (chord 85), tip x113 @TE, dihedral: tip +11mm (~6 deg)
wposRLE = χ 3 (ψ -40 (ζ -4 (zcyl 1.5 3)))
wposRTE = χ 3 (ψ 45 (ζ -4 (zcyl 1.5 3)))
wposTip = χ 113 (ψ 45 (ζ 7 (zcyl 1.5 3)))
wingR = wposRLE ⇓ wposRTE ⇓ wposTip
wingL = ⇋ 1 0 0 wingR

// --- horizontal stabilizer: 96 x 26 x 2.5 plate, TE at y=127 ---
// St=2496mm2 (~26% Sw), tail arm ~112mm -> Vh ~ 0.52
stab = ψ 114 (▣ 96 26 2.5 0)

// --- vertical fin: 2.5mm plate, triangle above boom ---
finA = ψ 92 (ζ 2 (xcyl 1.25 2.5))
finB = ψ 127 (ζ 2 (xcyl 1.25 2.5))
finC = ψ 127 (ζ 38 (xcyl 1.25 2.5))
fin = finA ⇓ finB ⇓ finC

// Closed fuselage bays leave a solid nose and bulkheads at the wing and tail.
bayFront = (ψ -76 (● 5.6)) ⇓ (ψ -39 (● 4.9))
bayMid = (ψ -23 (● 4.6)) ⇓ (ψ 36 (● 2.6))
bayAft = (ψ 46 (● 2.2)) ⇓ (ψ 94 (● 1.2))
shell = fuse ⊖ (bayFront ⊕ bayMid ⊕ bayAft)
cell0 = (zcyl 0.45 1.25 |> move 12 -27 -3.100) ⇓ (zcyl 0.45 1.25 |> move 12 44 -3.100) ⇓ (zcyl 0.45 1.25 |> move 46 44 0.300)
cell1 = (zcyl 0.45 1.25 |> move 49 4 0.600) ⇓ (zcyl 0.45 1.25 |> move 49 44 0.600) ⇓ (zcyl 0.45 1.25 |> move 76 44 3.300)
cell2 = (zcyl 0.45 1.25 |> move 79 26 3.600) ⇓ (zcyl 0.45 1.25 |> move 79 44 3.600) ⇓ (zcyl 0.45 1.25 |> move 102 44 5.900)
// Closed cavities leave upper and lower skins with ribs between the cells.
lightR = wingR ⊖ (cell0 ⊕ cell1 ⊕ cell2)
wings = (lightR ⊕ (⇋ 1 0 0 lightR)) |> move 0 4 0
grip = (box 8 21 2 |> move 0 11 -5) ⇓ (box 5 15 2 |> move 0 11 -12)
// Set the tail incidence for the estimated CG and glide lift coefficient.
trimTail = stab |> move 0 -114 0 |> rotx 4 |> move 0 114 0
main = ⬈ 1.134 1.134 1.134 (shell ⊕ wings ⊕ trimTail ⊕ fin ⊕ grip) |> rotz 45.0
