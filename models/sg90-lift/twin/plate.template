// Base uses the r4 socket, cable relief, crush ribs and footprint.
shell = (box 18 29 18 |> move 0 -5.2 9) ⊖ (box 12.8 23.4 20 |> move 0 -5.2 13.8) ⊖ (box 6 4 20 |> move 0 7.9 13.8)
side = zcyl 0.65 13 |> move 6.65 -10 10.5
endrib = zcyl 0.65 13 |> move 4.5 6.85 10.5
socket = shell ⊕ side ⊕ (side |> move -13.3 0 0) ⊕ endrib ⊕ (endrib |> move -9 0 0) ⊕ (endrib |> move 0 -24.1 0) ⊕ (endrib |> move -9 -24.1 0)
// Servo axes X +/-20, both cable outlets facing positive Y.
feet = (box 60 36 3 |> move 0 25 1.5) ⊕ (box 50 6 3 |> move 0 -17 1.5)
post = box 9 9 132.2 |> move 0 38.5 66.1
stop = box 9 9 46 |> move 0 24 23
key = box 5 5 5.8 |> move 0 38.5 135
frame = post ⊕ key ⊕ stop
base = (socket |> move -20 0 0) ⊕ (socket |> move 20 0 0) ⊕ feet ⊕ (frame |> move -20 0 0) ⊕ (frame |> move 20 0 0)
male = MALE_THREAD
hub = (zcyl 5.5 4.2 |> move 0 0 2.1) ⊖ (zcyl 2.475 9 |> move 0 0 2) ⊖ (frustum 2.885 2.465 0.42 |> move 0 0 -0.01)
journal = zcyl 3 5.8 |> move 0 0 97.8
screw = hub ⊕ (male |> move 0 0 4) ⊕ journal
female = NUT_PROFILE
nut = female |> move 0 0 -1
platform = (box 58 40 12 |> move 0 11 6) ⊖ (nut |> move -20 0 0) ⊖ (nut |> move 20 0 0)
bearing = zcyl 3.22 8 |> move 0 0 3
keyhole = box 4.95 4.95 8 |> move 0 38.5 3
cap = (box 55 51 6 |> move 0 18.5 3) ⊖ (keyhole |> move -20 0 0) ⊖ (keyhole |> move 20 0 0) ⊖ (bearing |> move -20 0 0) ⊖ (bearing |> move 20 0 0)
main = base ⊕ (platform |> move 70 0 0) ⊕ (cap |> move 0 65 0) ⊕ (screw |> move 55 58 0) ⊕ (screw |> move 80 58 0)
