// Sliding wall panel, 120 x 120. clearance is per contacting face, in mm.
// The 6.2 mm throat gets a 5.7 mm tongue, not an interference fit.
// Local X edges slide axially down the upright slots; local Y edges stay
// narrow so they can drop through the bottom rail mouth and accept a cap.
clearance = 0.25
neck = 6.2 - 2 * clearance
key_length = 109.4
lead = 3
// One-sided keys follow the 11 and 8.4 mm pockets, with clearance from
// every shoulder; this intermediate is reflected below.
wide_height = 5.5 - clearance + neck / 2
deep_height = 4.2 - clearance + neck / 2
wide = (box (1.8 - 2 * clearance) (key_length - 2 * lead) wide_height |> move 57.7 0 ((wide_height - neck) / 2))
  |> hull (box (1.8 - 2 * clearance) key_length neck |> move 57.7 0 0)
deep = (box (1.3 - 2 * clearance) (key_length - 2 * lead) deep_height |> move 59.25 0 ((deep_height - neck) / 2))
  |> hull (box (1.3 - 2 * clearance) key_length neck |> move 59.25 0 0)
edge = wide |> add deep
one_sided = box 120 120 neck |> add edge |> add (⇋ 1 0 0 edge)

// Full 120 x 120 mm wall, with the tested 0.25 mm bilateral T-heads.
// Keys stop 5.3 mm short of each corner; 3 mm ramps need no supports upright.
panel = one_sided |> add (⇋ 0 0 1 one_sided)

// Same support-free insertion-axis print pose as the successful 70 mm wall.
ears = (zcyl 4 0.2 |> move -42 -4 0.1)
  |> add (zcyl 4 0.2 |> move -42 4 0.1)
  |> add (zcyl 4 0.2 |> move 42 -4 0.1)
  |> add (zcyl 4 0.2 |> move 42 4 0.1)
main = (panel |> rotx 90 |> z 60) |> add ears
