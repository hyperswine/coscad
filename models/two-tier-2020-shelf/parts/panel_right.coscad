// 200 mm panel, 3 mm skin over 8 mm ribs. Four recessed M5x12 mounts.
skin = box 200 200 3 |> z 9.5
ribs = (box 20 200 8.1 |> move -90 0 4.05) ⊕ (box 20 200 8.1 |> move 90 0 4.05) ⊕ (box 200 20 8.1 |> move 0 -90 4.05) ⊕ (box 200 20 8.1 |> move 0 90 4.05) ⊕ (box 4 200 8.1 |> move -50 0 4.05) ⊕ (box 4 200 8.1 |> move 0 0 4.05) ⊕ (box 4 200 8.1 |> move 50 0 4.05) ⊕ (box 200 4 8.1 |> move 0 -50 4.05) ⊕ (box 200 4 8.1 |> move 0 0 4.05) ⊕ (box 200 4 8.1 |> move 0 50 4.05)
main = (skin ⊕ ribs) ∩ (box 199.6 199.6 12 |> z 5.5) |> cut (box 20.6 20.6 30 |> move -100 -90 5) |> cut (box 20.6 20.6 30 |> move -100 90 5) |> cut (box 20.6 20.6 30 |> move 90 -90 5) |> cut (box 20.6 20.6 30 |> move 90 90 5) |> cut (zcyl 2.8 30 |> move -50 -90 5) |> cut (zcyl 5.5 10 |> move -50 -90 11) |> cut (zcyl 2.8 30 |> move -50 90 5) |> cut (zcyl 5.5 10 |> move -50 90 11) |> cut (zcyl 2.8 30 |> move 50 -90 5) |> cut (zcyl 5.5 10 |> move 50 -90 11) |> cut (zcyl 2.8 30 |> move 50 90 5) |> cut (zcyl 5.5 10 |> move 50 90 11)
