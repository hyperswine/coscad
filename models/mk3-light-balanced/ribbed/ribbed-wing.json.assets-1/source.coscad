// One-piece Mk3 light. Construction coordinates in mm, scaled for the bed.
// Y runs aft and Z runs up.

// --- fuselage: piecewise hulls of spheres (round cross-sections) ---
// nose tip r2.5 @-128, max section r9 @-95, mid r7 @-15, boom r3.5 @+70, tail r2.5 @+126
fnose = ψ -128 (● 2.5)
fmax  = ψ -95 (● 9)
fmid  = ψ -15 (● 7)
fboom = ψ 70 (● 3.5)
ftail = ψ 126 (● 2.5)
fuse  = (fnose ⇓ fmax) ⊕ (fmax ⇓ fmid) ⊕ (fmid ⇓ fboom) ⊕ (fboom ⇓ ftail)

// --- right wing: 3mm plate = hull of 3 short posts (delta, tips at TE) ---
// root LE y-40, root TE y+45 (chord 85), tip x113 @TE, dihedral: tip +11mm (~6 deg)
wposRLE = χ 3 (ψ -40 (ζ -4 (zcyl 1.5 3)))
wposRTE = χ 3 (ψ 45 (ζ -4 (zcyl 1.5 3)))
wposTip = χ 113 (ψ 45 (ζ 7 (zcyl 1.5 3)))
wingR = wposRLE ⇓ wposRTE ⇓ wposTip
wingL = ⇋ 1 0 0 wingR

// --- horizontal stabilizer: 96 x 26 x 2.5 plate, TE at y=127 ---
// St=2496mm2 (~26% Sw), tail arm ~112mm -> Vh ~ 0.52
// Swept leading edge, straight trailing edge, 96 mm span before scaling.
stab = (⮕ 1.6 (poly 0 75 48 127 0 127 -48 127)) |> move 0 0 -0.8

// --- vertical fin: 2.5mm plate, triangle above boom ---
finA = ψ 92 (ζ 2 (xcyl 1.25 2.5))
finB = ψ 127 (ζ 2 (xcyl 1.25 2.5))
finC = ψ 127 (ζ 38 (xcyl 1.25 2.5))
fin = finA ⇓ finB ⇓ finC

// Closed fuselage bays leave a solid nose and bulkheads at the wing and tail.
bayFront = (ψ -76 (● 5.6)) ⇓ (ψ -39 (● 4.9))
bayMid = (ψ -23 (● 4.6)) ⇓ (ψ 36 (● 2.6))
bayAft = (ψ 46 (● 2.2)) ⇓ (ψ 94 (● 1.2))
shell = fuse ⊖ (bayFront ⊕ bayMid ⊕ bayAft)
// Closed cavities leave upper and lower skins with ribs between the cells.
grip = (box 8 21 2 |> move 0 39 -4) ⇓ (box 5 15 2 |> move 0 39 -10)
// Set the tail incidence for the estimated CG and glide lift coefficient.
trimTail = stab |> move 0 -114 0 |> rotx 6 |> move 0 114 0
root = (zcyl 1.5 6 |> move 0 -40 -4) ⇓ (zcyl 1.5 6 |> move 0 45 -4) ⇓ (zcyl 1.5 6 |> move 3 -40 -4) ⇓ (zcyl 1.5 6 |> move 3 45 -4) ⇓ (zcyl 1.5 3 |> move 20 -26.8636 -2.3) ⇓ (zcyl 1.5 3 |> move 20 45 -2.3)
lightR = (wingR ⊕ root) ⊖ (((zcyl 0.12 4.0941 |> move 7 -36.2591 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 -29.3682 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -26.6773 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -20.7445 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 -28.0682 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 -21.1773 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -19.4445 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -13.5118 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 -19.8773 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 -12.9864 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -12.2118 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -6.2791 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 -11.6864 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 -4.7955 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 -4.9791 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 0.9536 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 -3.4955 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 3.3955 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 2.2536 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 8.1864 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 4.6955 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 11.5864 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 9.4864 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 15.4191 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 12.8864 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 19.7773 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 16.7191 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 22.6518 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 21.0773 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 27.9682 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 23.9518 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 29.8845 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 29.2682 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 36.1591 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 31.1845 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 37.1173 -2.36)) ⊕ ((zcyl 0.12 4.0941 |> move 7 37.4591 -3.6) ⇓ (zcyl 0.12 4.0941 |> move 7 44.35 -3.6) ⇓ (zcyl 0.12 1.9059 |> move 19.4 38.4173 -2.36) ⇓ (zcyl 0.12 1.9059 |> move 19.4 44.35 -2.36)) ⊕ ((zcyl 0.12 1.8 |> move 20.6 -25.75 -2.24) ⇓ (zcyl 0.12 1.8 |> move 20.6 -19.91 -2.24) ⇓ (zcyl 0.12 1.8 |> move