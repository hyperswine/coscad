// 2020 rail, 420mm, running along Y (x0 preview part).
// Slot geometry matched to the measured extrusion: mouth 6.4 wide x 1.8
// deep, chamber 2.8 deep x 9.5 wide behind the lip (lip inner at 8.2).
r = box 20 420 20
main = r
  |> cutat rt (box 3.6 422 6.4)
  |> cutat lft (box 3.6 422 6.4)
  |> cutat top (box 6.4 422 3.6)
  |> cutat bot (box 6.4 422 3.6)
  |> cutat ctr 6.8 0 0 (box 2.8 422 9.5)
  |> cutat ctr -6.8 0 0 (box 2.8 422 9.5)
  |> cutat ctr 0 0 6.8 (box 9.5 422 2.8)
  |> cutat ctr 0 0 -6.8 (box 9.5 422 2.8)
  |> cutat ctr (ycyl 2.1 422)
// Oriented joint interfaces; construction metadata does not add material.
  |> frame butt_railX1 ctr rt top 10 -200 0
  |> frame butt_railX3 ctr rt top 10 0 0
  |> frame butt_railX5 ctr rt top 10 200 0
  |> frame butt_railX1_2 ctr lft top -10 -200 0
  |> frame slot_mount_bracket1 ctr rt top 10 105 0
  |> frame slot_mount_bracket2 ctr rt top 10 -105 0
  |> frame slot_mount_bracket3 ctr lft top -10 105 0
  |> frame slot_mount_bracket4 ctr lft top -10 -105 0
  |> frame corner_seat_corner1 ctr rt top -18.5 188 0
  |> frame corner_seat_corner2 ctr rt top 12 181.5 0
  |> frame corner_seat_corner3 ctr rt top 18.5 -188 0
  |> frame corner_seat_corner4 ctr rt top -12 -181.5 0
