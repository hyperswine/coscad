bracket12 ← bracket_seam.coscad ×1 ▽fwd material=petg
bracket13 ← bracket_seam.coscad ×1 ▽fwd material=petg
bracket14 ← bracket_seam.coscad ×1 ▽fwd material=petg
bracket15 ← bracket_seam.coscad ×1 ▽fwd material=petg
bracket16 ← bracket_seam.coscad ×1 ▽fwd material=petg
tnut1 ← tnut_m5.coscad ×0
tnut2 ← tnut_m5.coscad ×0
tnut3 ← tnut_m5.coscad ×0
tnut4 ← tnut_m5.coscad ×0
tnut5 ← tnut_m5.coscad ×0
tnut6 ← tnut_m5.coscad ×0
tnut7 ← tnut_m5.coscad ×0
tnut8 ← tnut_m5.coscad ×0
tnut9 ← tnut_m5.coscad ×0
tnut10 ← tnut_m5.coscad ×0
tnut11 ← tnut_m5.coscad ×0
tnut12 ← tnut_m5.coscad ×0
tnut13 ← tnut_m5.coscad ×0
tnut14 ← tnut_m5.coscad ×0
tnut15 ← tnut_m5.coscad ×0
tnut16 ← tnut_m5.coscad ×0
corner1 ← corner_90.coscad ×0
corner2 ← corner_90.coscad ×0
corner3 ← corner_90.coscad ×0
corner4 ← corner_90.coscad ×0
panel1 ← panel_corner.coscad ×1 ▽bot material=petg
panel2 ← panel_corner.coscad ×1 ▽bot material=petg
panel3 ← panel_corner.coscad ×1 ▽bot material=petg
panel4 ← panel_corner.coscad ×1 ▽bot material=petg

fixed railY1 -200 0 10 0 0 0
mate railX1 @butt_railY1 railY1 @butt_railX1
mate railX2 @butt_railY1 railY2 @butt_railX1
mate railX3 @butt_railY1 railY1 @butt_railX3
mate railX4 @butt_railY1 railY2 @butt_railX3
mate railX5 @butt_railY1 railY1 @butt_railX5
mate railX6 @butt_railY1 railY2 @butt_railX5
mate railY2 @butt_railX1_2 railX1 @butt_railY2
mate railY3 @butt_railX1_2 railX2 @butt_railY2
mate bracket1 @slot_mount_railY2 railY2 @slot_mount_bracket1
mate tnut1 @nut_seat_bracket1 bracket1 @slot_mount_railY2
mate bracket2 @slot_mount_railY2 railY2 @slot_mount_bracket2
mate tnut2 @nut_seat_bracket1 bracket2 @slot_mount_railY2
mate bracket3 @slot_mount_railY2 railY2 @slot_mount_bracket3
mate tnut3 @nut_seat_bracket1 bracket3 @slot_mount_railY2
mate bracket4 @slot_mount_railY2 railY2 @slot_mount_bracket4
mate tnut4 @nut_seat_bracket1 bracket4 @slot_mount_railY2
mate bracket5 @slot_mount_railY2 railY1 @slot_mount_bracket1
mate tnut5 @nut_seat_bracket5 bracket5 @slot_mount_railY2
mate bracket6 @slot_mount_railY2 railY1 @slot_mount_bracket2
mate tnut6 @nut_seat_bracket5 bracket6 @slot_mount_railY2
mate bracket7 @slot_mount_railY2 railY3 @slot_mount_bracket3
mate tnut7 @nut_seat_bracket5 bracket7 @slot_mount_railY2
mate bracket8 @slot_mount_railY2 railY3 @slot_mount_bracket4
mate tnut8 @nut_seat_bracket5 bracket8 @slot_mount_railY2
mate bracket9 @slot_mount_railY2 railX4 @slot_mount_bracket9
mate tnut9 @nut_seat_bracket1 bracket9 @slot_mount_railY2
mate bracket10 @slot_mount_railY2 railX3 @slot_mount_bracket10
mate tnut10 @nut_seat_bracket1 bracket10 @slot_mount_railY2
mate bracket11 @slot_mount_railY2 railX4 @slot_mount_bracket11
mate tnut11 @nut_seat_bracket1 bracket11 @slot_mount_railY2
mate bracket12 @slot_mount_railY2 railX3 @slot_mount_bracket12
mate tnut12 @nut_seat_bracket1 bracket12 @slot_mount_railY2
mate bracket13 @slot_mount_railY2 railX2 @slot_mount_bracket9
mate tnut13 @nut_seat_bracket1 bracket13 @slot_mount_railY2
mate bracket14 @slot_mount_railY2 railX1 @slot_mount_bracket10
mate tnut14 @nut_seat_bracket1 bracket14 @slot_mount_railY2
mate bracket15 @slot_mount_railY2 railX6 @slot_mount_bracket11
mate tnut15 @nut_seat_bracket1 bracket15 @slot_mount_railY2
mate bracket16 @slot_mount_railY2 railX5 @slot_mount_bracket12
mate tnut16 @nut_seat_bracket1 bracket16 @slot_mount_railY2
mate corner1 @corner_seat_railY3 railY3 @corner_seat_corner1
mate corner2 @corner_seat_railY1 railY1 @corner_seat_corner2
mate corner3 @corner_seat_railY1_2 railY1 @corner_seat_corner3
mate corner4 @corner_seat_railY3_2 railY3 @corner_seat_corner4
mate panel1 @panel_support_railX6 railX6 @panel_support_panel1
mate panel2 @panel_support_railX5 railX5 @panel_support_panel2 roll=90
mate panel3 @panel_support_railX6 railX1 @panel_support_panel2 roll=180
mate panel4 @panel_support_railX5 railX2 @panel_support_panel1 roll=-90
